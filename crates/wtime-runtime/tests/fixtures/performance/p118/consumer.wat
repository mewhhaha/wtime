;; SPDX-License-Identifier: CC0-1.0
(module
 (type $object (struct (field i32)))
 (type $result (func (result (ref $object))))
 (type $step (func (param (ref $object)) (result (ref $object))))
 (type $c1 (cont $step))
 (type $c0 (cont $result))
 (import "provider" "yield" (tag $yield (result (ref $object))))
 (import "env" "fail" (func $fail))
 (func (export "run") (type $result)
  i32.const 6 i32.const 7 i32.add drop
  suspend $yield)
 (func (export "make") (result (ref $object))
  i32.const 77 struct.new $object)
 (func (export "get") (param (ref $object)) (result i32)
  local.get 0 struct.get $object 0)
 (func (export "bind") (param (ref $c1)) (param (ref $object)) (result (ref $c0))
  local.get 1 local.get 0 cont.bind $c1 $c0)
 (func (export "resume") (param (ref $c1)) (param (ref $object)) (result (ref $object))
  local.get 1 local.get 0 resume $c1)
 (func (export "resume_bound") (param (ref $c0)) (result (ref $object))
  local.get 0 resume $c0)
 (func (export "host_failure") (param (ref $c1)) (param (ref $object)) (result (ref $object))
  local.get 1 local.get 0 call $fail resume $c1))
