;; SPDX-License-Identifier: CC0-1.0
(module
  ;; This target has scalar and SIMD parameters plus one nonparameter local of
  ;; every supported value type. Every check observes the freshly zeroed local.
  (func $checked_target
    (param $pi i32) (param $pl i64) (param $pf f32) (param $pd f64) (param $pv v128)
    (result i32)
    (local $li i32) (local $ll i64) (local $lf f32) (local $ld f64) (local $lv v128)
    (local.get $li)
    (i32.eqz)
    (local.get $ll)
    (i64.eqz)
    (i32.and)
    (local.get $lf)
    (f32.reinterpret_i32)
    (i32.eqz)
    (i32.and)
    (local.get $ld)
    (f64.reinterpret_i64)
    (i64.eqz)
    (i32.and)
    (local.get $lv)
    (v128.any_true)
    (i32.eqz)
    (i32.and)
    (i32.const 42)
    (i32.mul))
  (export "checked_target" (func $checked_target))

  ;; Two calls exercise fresh activations and produce the deterministic checksum 84.
  (func (export "run") (result i32)
    (i32.const 7)
    (i64.const 9)
    (f32.const 1.5)
    (f64.const -2.25)
    (v128.const i32x4 1 2 3 4)
    (call $checked_target)
    (i32.const 8)
    (i64.const 10)
    (f32.const -0.5)
    (f64.const 3.125)
    (v128.const i32x4 -1 0 17 99)
    (call $checked_target)
    (i32.add)))
