(module
  (type $frame (func (param i32 i64 f32 f64 v128) (result i32)))
  (func $target (type $frame)
    (param $pi i32) (param $pl i64) (param $pf f32) (param $pd f64) (param $pv v128)
    (result i32)
    (local $li i32) (local $ll i64) (local $lf f32) (local $ld f64) (local $lv v128)
    (local.get $li) (i32.eqz)
    (local.get $ll) (i64.eqz) (i32.and)
    (local.get $lf) (f32.reinterpret_i32) (i32.eqz) (i32.and)
    (local.get $ld) (f64.reinterpret_i64) (i64.eqz) (i32.and)
    (local.get $lv) (v128.any_true) (i32.eqz) (i32.and)
    (i32.const 42) (i32.mul))
  (func $tail_entry (type $frame)
    (param i32 i64 f32 f64 v128) (result i32)
    (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4)
    (return_call $target))
  (func (export "run") (result i32)
    (i32.const 13) (i64.const -4) (f32.const 0.25) (f64.const 7.5)
    (v128.const i32x4 5 6 7 8)
    (call $tail_entry)))
