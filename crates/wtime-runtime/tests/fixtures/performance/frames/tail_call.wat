(module
  (type $frame (func (param i32 i64 f32 f64 v128) (result i32)))
  (func $target (type $frame)
    (param $pi i32) (param $pl i64) (param $pf f32) (param $pd f64) (param $pv v128)
    (result i32)
    (local $li i32) (local $ll i64) (local $lf f32) (local $ld f64) (local $lv v128) (local $result i32)
    (local.get $li) (i32.eqz)
    (local.get $ll) (i64.eqz) (i32.and)
    (local.get $lf) (i32.reinterpret_f32) (i32.eqz) (i32.and)
    (local.get $ld) (i64.reinterpret_f64) (i64.eqz) (i32.and)
    (local.get $lv) (v128.any_true) (i32.eqz) (i32.and)
    (local.get $result) (i32.eqz) (i32.and)
    ;; Validate the exact forwarded arguments as well as zeroed locals.
    (local.get $pi) (i32.const 13) (i32.eq) (i32.and)
    (local.get $pl) (i64.const -4) (i64.eq) (i32.and)
    (local.get $pf) (i32.reinterpret_f32) (i32.const 1048576000) (i32.eq) (i32.and)
    (local.get $pd) (i64.reinterpret_f64) (i64.const 4620130267728707584) (i64.eq) (i32.and)
    (local.get $pv) (i32x4.extract_lane 0) (i32.const 5) (i32.eq) (i32.and)
    (local.get $pv) (i32x4.extract_lane 1) (i32.const 6) (i32.eq) (i32.and)
    (local.get $pv) (i32x4.extract_lane 2) (i32.const 7) (i32.eq) (i32.and)
    (local.get $pv) (i32x4.extract_lane 3) (i32.const 8) (i32.eq) (i32.and)
    (i32.const 42) (i32.mul) (local.set $result)
    (i32.const 1) (local.set $li)
    (i64.const 1) (local.set $ll)
    (f32.const 1) (local.set $lf)
    (f64.const 1) (local.set $ld)
    (v128.const i32x4 1 1 1 1) (local.set $lv)
    (local.get $result))
  (func $tail_entry (type $frame)
    (param i32 i64 f32 f64 v128) (result i32)
    (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4)
    (return_call $target))
  (func (export "run") (result i32)
    (i32.const 13) (i64.const -4) (f32.const 0.25) (f64.const 7.5)
    (v128.const i32x4 5 6 7 8)
    (call $tail_entry)))
