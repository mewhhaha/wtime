(module
  (type $worker (func (result i32)))
  (type $start (cont $worker))
  (type $resumer (func (param i32) (result i32)))
  (type $rest (cont $resumer))
  (tag $pause (result i32))
  (tag $error (param i32))
  (func (export "worker") (type $worker)
    (block $caught (result i32)
      (try_table (result i32) (catch $error $caught)
        (suspend $pause))))
  (func (export "resume_throw") (param $continuation (ref null $rest)) (result i32)
    (i32.const 29)
    (local.get $continuation)
    (resume_throw $rest $error)))
