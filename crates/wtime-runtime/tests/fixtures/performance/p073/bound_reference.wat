(module
  (type $blob (struct (field i32)))
  (type $consume (func (param (ref $blob) i32 i32) (result i32)))
  (type $full (cont $consume))
  (type $resumer (func (param i32) (result i32)))
  (type $rest (cont $resumer))
  (func $consume (type $consume)
    (i32.add
      (struct.get $blob 0 (local.get 0))
      (i32.add (local.get 1) (local.get 2))))
  (elem declare func $consume)
  (func (export "bind") (result (ref $rest))
    (struct.new $blob (i32.const 31))
    (i32.const 4)
    (ref.func $consume)
    (cont.new $full)
    (cont.bind $full $rest))
  (func (export "resume") (param $continuation (ref null $rest)) (result i32)
    (i32.const 7)
    (local.get $continuation)
    (resume $rest)))
