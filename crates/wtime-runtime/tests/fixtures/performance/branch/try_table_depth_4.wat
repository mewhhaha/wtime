(module
  (type $resume_step (func (param i32) (result i32)))
  (type $cont (cont $resume_step))
  (tag $yield (type $resume_step))
  (tag $failure (param i32))
  ;; Every active try_table handler targets the surrounding result block.
  ;; This fixture has 4 active try_table labels plus that target block.
  (func (export "run") (result i32)
    (block (result i32)
      (try_table (catch $failure 0)
        (try_table (catch $failure 1)
          (try_table (catch $failure 2)
            (try_table (catch $failure 3)
              (i32.const 7)
              (suspend $yield)
              (drop)
              (i32.const 29)
              (throw $failure)
            )
          )
        )
      )
      (i32.const 0)
    )
  )
  (func (export "resume") (param (ref $cont)) (result i32)
    (i32.const 9)
    (local.get 0)
    (resume $cont))
)
