;; Original P034 high-local-type-index fixture; CC0-1.0.
(module
  (type $preceding_func_0000 (func))
  (type $preceding_func_0001 (func))
  (type $preceding_func_0002 (func))
  (type $preceding_func_0003 (func))
  (type $preceding_func_0004 (func))
  (type $preceding_func_0005 (func))
  (type $preceding_func_0006 (func))
  (type $preceding_func_0007 (func))
  (type $preceding_func_0008 (func))
  (type $preceding_func_0009 (func))
  (type $preceding_func_0010 (func))
  (type $preceding_func_0011 (func))
  (type $preceding_func_0012 (func))
  (type $preceding_func_0013 (func))
  (type $preceding_func_0014 (func))
  (type $preceding_func_0015 (func))
  ;; Local type index 16: packed mutable byte array.
  (type $packed_array_16 (array (mut i8)))
  ;; Local type index 17: packed mutable byte struct field.
  (type $packed_struct_16 (struct (field (mut i8))))
  (func (export "run") (param $n i32) (result i32)
    (local $items (ref null $packed_array_16))
    (local $i i32)
    (local $sum i32)
    (local.set $items (array.new $packed_array_16 (i32.const -1) (i32.const 1)))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $sum (i32.add (local.get $sum)
          (array.get_u $packed_array_16 (local.get $items) (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (local.get $sum))
  (func (export "run_struct") (param $n i32) (result i32)
    (local $cell (ref null $packed_struct_16))
    (local $i i32)
    (local $sum i32)
    (local.set $cell (struct.new $packed_struct_16 (i32.const -1)))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $sum (i32.add (local.get $sum)
          (struct.get_u $packed_struct_16 0 (local.get $cell))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (local.get $sum))
)
