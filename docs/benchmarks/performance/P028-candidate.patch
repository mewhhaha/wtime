+            (
+                0x6f,
+                vec![Value::I32(8), Value::I32(2), Value::I32(0)],
+                vec![Value::I32(8)],
+                "integer divide by zero",
+            ),
+            (
+                0x7f,
+                vec![Value::I64(8), Value::I64(2), Value::I64(0)],
+                vec![Value::I64(8)],
+                "integer divide by zero",
+            ),
+            (
+                0x81,
+                vec![Value::I64(8), Value::I64(2), Value::I64(0)],
+                vec![Value::I64(8)],
+                "integer divide by zero",
+            ),
+            (
+                0x6d,
+                vec![Value::I32(i32::MIN), Value::I32(-1)],
+                vec![],
+                "integer overflow",
+            ),
+        ] {
+            reset_in_place_test_count();
+            let error = exec(op, &mut stack).unwrap_err();
+            assert_eq!(error.kind, ErrorKind::Trap);
+            assert_eq!(error.message, message);
+            assert_eq!(stack, remaining);
+            assert_eq!(
+                in_place_test_count(),
+                0,
+                "opcode {op:#x} should use old path"
+            );
+        }
+
+        for (op, mut stack, expected) in [
+            (
+                0x92,
+                vec![Value::F32(0x3f80_0000), Value::F32(0x4000_0000)],
+                Value::F32(0x4040_0000),
+            ),
+            (0xa7, vec![Value::I64(0x1_0000_0001)], Value::I32(1)),
+        ] {
+            reset_in_place_test_count();
+            exec(op, &mut stack).unwrap();
+            assert_eq!(stack, [expected]);
+            assert_eq!(
+                in_place_test_count(),
+                0,
+                "opcode {op:#x} should use old path"
+            );
+        }
+
+        reset_in_place_test_count();
+        let mut bad_conversion = vec![Value::F32(0x7fc0_0000)];
+        let error = exec(0xa8, &mut bad_conversion).unwrap_err();
+        assert_eq!(error.message, "invalid integer conversion");
+        assert!(bad_conversion.is_empty());
+        assert_eq!(in_place_test_count(), 0);
+    }
