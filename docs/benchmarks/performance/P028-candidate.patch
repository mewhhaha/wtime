+// Unit-test-only evidence that a valid operand suffix reaches the direct
+// overwrite/truncate branch. Thread-local scope keeps unrelated parallel
+// numeric tests from contaminating the assertion; production builds contain
+// no counter or event call.
+#[cfg(test)]
+std::thread_local! {
+    static P028_IN_PLACE_OPS: std::cell::Cell<u64> = std::cell::Cell::new(0);
+}
+#[cfg(test)]
+fn record_in_place_for_test() {
+    P028_IN_PLACE_OPS.with(|count| count.set(count.get().saturating_add(1)));
+}
+#[cfg(test)]
+fn reset_in_place_test_count() {
+    P028_IN_PLACE_OPS.with(|count| count.set(0));
+}
+#[cfg(test)]
+fn in_place_test_count() -> u64 {
+    P028_IN_PLACE_OPS.with(|count| count.get())
