+#[cfg(test)]
+mod p032_tests {
+    use super::*;
+    fn setup(bytes: &[u8], depth: usize) -> (Store, Instance) {
+        let mut config = Config::default();
+        config.limits.max_call_depth = depth;
+        let engine = Engine::new(config).unwrap();
+        let module = engine.compile(bytes).unwrap();
+        let mut store = Store::new(&engine);
+        let instance = Linker::new(&engine)
+            .instantiate(&mut store, &module)
+            .unwrap();
+        (store, instance)
+    }
+    fn run(store: &mut Store, instance: Instance, args: &[Value]) -> RunOutcome {
+        let External::Func(function) = instance.export(store, "run").unwrap() else {
+            panic!("run");
+        };
+        P032_ARGUMENT_RANGES.with(|hits| hits.set(0));
+        store.invoke(function, args).unwrap()
+    }
+    fn hits() -> u64 {
+        P032_ARGUMENT_RANGES.with(std::cell::Cell::get)
+    }
+    #[test]
+    fn p032_indirect_arguments_use_owned_locals_without_intermediate_buffer() {
+        let (mut store, instance) = setup(
+            include_bytes!("../tests/fixtures/performance/calls/indirect-good.wasm"),
+            16,
+        );
+        assert_eq!(
+            run(&mut store, instance, &[Value::I32(5)]),
+            RunOutcome::Returned(vec![Value::I32(12)])
+        );
+        assert_eq!(hits(), 1);
+        #[cfg(feature = "performance-counters")]
+        assert_eq!(
+            store.perf.snapshot().argument_allocations,
+            1,
+            "only the public invocation owns an argument buffer"
+        );
+    }
+    #[test]
+    fn p032_tail_argument_overlap_keeps_original_caller_base() {
+        let (mut store, instance) = setup(
+            include_bytes!("../tests/fixtures/performance/calls/tail-recursive.wasm"),
+            2,
+        );
+        assert_eq!(
+            run(&mut store, instance, &[Value::I32(128)]),
+            RunOutcome::Returned(vec![Value::I32(23)])
+        );
+        assert_eq!(hits(), 129);
+        #[cfg(feature = "performance-counters")]
+        assert_eq!(store.perf.snapshot().argument_allocations, 1);
+    }
+    #[test]
+    fn p032_reference_arguments_remain_checked_and_drop_with_locals() {
+        let (mut store, instance) = setup(
+            include_bytes!("../tests/fixtures/performance/frames/reference_control.wasm"),
+            16,
+        );
+        assert_eq!(
+            run(&mut store, instance, &[]),
+            RunOutcome::Returned(vec![Value::I32(41)])
+        );
+        assert_eq!(
+            hits(),
+            1,
+            "checked reference suffix takes the actual range construction path"
+        );
+        let collected = store.collect().unwrap();
+        assert_eq!(collected.reclaimed, 1);
+        assert_eq!(collected.live, 0);
+        assert_eq!(store.gc_payload_bytes(), 0);
+        #[cfg(feature = "performance-counters")]
+        assert_eq!(store.perf.snapshot().argument_allocations, 0);
+        let target = |store: &Store, name: &str| {
+            let External::Func(function) = instance.export(store, name).unwrap() else {
+                panic!("function");
+            };
+            function
+        };
+        let identity = target(&store, "identity");
+        let make_s = target(&store, "make_s");
+        let make_u = target(&store, "make_u");
+        let RunOutcome::Returned(s_values) = store.invoke(make_s, &[]).unwrap() else {
+            panic!("make_s");
+        };
+        let RunOutcome::Returned(u_values) = store.invoke(make_u, &[]).unwrap() else {
+            panic!("make_u");
+        };
+        let operands = vec![Value::I32(9), s_values[0]];
+        let frame = store
+            .guest_frame_from_range(identity, &operands[1..], 1, false)
+            .unwrap();
+        assert_eq!(frame.locals, vec![s_values[0]]);
+        assert_eq!(frame.base, 1);
+        assert_eq!(
+            operands,
+            vec![Value::I32(9), s_values[0]],
+            "constructor does not consume borrowed operands"
+        );
+        drop(frame);
+        assert_eq!(hits(), 2);
+        for wrong in [&[][..], &[Value::I32(41)][..], &u_values[..]] {
+            assert_eq!(
+                store
+                    .guest_frame_from_range(identity, wrong, 0, false)
+                    .err()
+                    .unwrap()
+                    .kind,
+                ErrorKind::Host
+            );
+        }
+        let mut foreign = Store::new(&store.engine);
+        let module = store
+            .engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/frames/reference_control.wasm"
+            ))
+            .unwrap();
+        let foreign_instance = Linker::new(&store.engine)
+            .instantiate(&mut foreign, &module)
+            .unwrap();
+        let External::Func(foreign_make) = foreign_instance.export(&foreign, "make_s").unwrap()
+        else {
+            panic!("foreign make");
+        };
+        let RunOutcome::Returned(foreign_values) = foreign.invoke(foreign_make, &[]).unwrap()
+        else {
+            panic!("foreign result");
+        };
+        assert_eq!(
+            store
+                .guest_frame_from_range(identity, &foreign_values, 0, false)
+                .err()
+                .unwrap()
+                .kind,
+            ErrorKind::Host
+        );
+        assert_eq!(
+            hits(),
+            2,
+            "failed admission cannot record a completed guest range"
+        );
+        store.release_published(&[s_values[0], u_values[0]]);
+        foreign.release_published(&foreign_values);
+        assert_eq!(store.collect().unwrap().reclaimed, 2);
+        assert_eq!(foreign.collect().unwrap().reclaimed, 1);
+        assert_eq!(store.gc_payload_bytes(), 0);
+        assert_eq!(foreign.gc_payload_bytes(), 0);
+    }
+    #[test]
+    fn p032_guest_to_host_transition_still_owns_arguments_and_roots() {
+        let engine = Engine::new(Config::default()).unwrap();
+        let module = engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/calls/imported-direct.wasm"
+            ))
+            .unwrap();
+        let mut store = Store::new(&engine);
+        let nested_module = engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/frames/guest_frame.wasm"
+            ))
+            .unwrap();
+        let nested_instance = Linker::new(&engine)
+            .instantiate(&mut store, &nested_module)
+            .unwrap();
+        let External::Func(nested) = nested_instance.export(&store, "run").unwrap() else {
+            panic!("nested run");
+        };
+        let host = store
+            .create_host_func_with_caller(
+                FuncType::new(vec![ValType::I32], vec![ValType::I32]),
+                move |caller, arguments| {
+                    assert_eq!(arguments, &[Value::I32(5)]);
+                    assert!(
+                        caller
+                            .store
+                            .active_roots
+                            .iter()
+                            .any(|values| values.contains(&Value::I32(5)))
+                    );
+                    assert_eq!(
+                        caller.invoke(nested, &[])?,
+                        RunOutcome::Returned(vec![Value::I32(84)])
+                    );
+                    for _ in 0..1024 {
+                        caller
+                            .store
+                            .create_host_func(FuncType::new(vec![], vec![]), |_| Ok(vec![]))?;
+                    }
+                    assert_eq!(caller.store.collect()?.live, 0);
+                    assert_eq!(
+                        arguments,
+                        &[Value::I32(5)],
+                        "owned host args survive reentry and arena growth"
+                    );
+                    assert!(
+                        caller
+                            .store
+                            .active_roots
+                            .iter()
+                            .any(|values| values.contains(&Value::I32(5)))
+                    );
+                    Ok(vec![Value::I32(6)])
+                },
+            )
+            .unwrap();
+        let mut linker = Linker::new(&engine);
+        linker.define("host", "bump", External::Func(host)).unwrap();
+        let instance = linker.instantiate(&mut store, &module).unwrap();
+        assert_eq!(
+            run(&mut store, instance, &[Value::I32(5)]),
+            RunOutcome::Returned(vec![Value::I32(10)])
+        );
+        assert_eq!(
+            hits(),
+            3,
+            "one outer guest wrapper plus two nested guest calls use ranges; the imported host keeps owned arguments"
+        );
+        #[cfg(feature = "performance-counters")]
+        assert_eq!(store.perf.snapshot().argument_allocations, 2);
+    }
+}
