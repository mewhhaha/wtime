+    // Only decoded dispatch after target admission may borrow this suffix.
+    // Owned locals are completed before the operand suffix is destroyed.
+    fn guest_frame_from_range(
+        &self,
+        f: Func,
+        args: &[Value],
+        base: usize,
+        _certified_direct: bool,
+    ) -> Result<Frame> {
+        let k = self.check(f.0, &self.funcs)?;
+        let fun = self.funcs[k].clone();
+        if fun.host.is_some() {
+            return Err(err(
+                ErrorKind::Host,
+                "guest argument range requires a guest target",
+            ));
+        }
+        let certified = false;
+        if !certified {
+            for value in args {
+                self.validate_value(*value)?;
+            }
+        }
+        if args.len() != fun.ty.params.len()
+            || (!certified
+                && !args.iter().zip(&fun.ty.params).all(|(v, t)| match t {
+                    ValType::Ref(reference) => {
+                        matches_type(*v, *t)
+                            || self
+                                .gc_matches(fun.instance, *v, *reference)
+                                .unwrap_or(false)
+                    }
+                    _ => matches_type(*v, *t),
+                }))
+        {
+            return Err(err(ErrorKind::Host, "argument type mismatch"));
+        }
+        let module = &self.instances[fun.instance].module;
+        let body = &module.data.inner.decoded().code[fun.body];
+        let layout = module.function_layout(fun.body);
+        let local_types = layout
+            .as_ref()
+            .map_or(body.locals.as_slice(), |plan| plan.locals);
+        let count = args
+            .len()
+            .checked_add(local_types.len())
+            .ok_or_else(|| err(ErrorKind::ResourceLimit, "frame locals allocation failed"))?;
+        let mut locals = Vec::new();
+        locals
+            .try_reserve_exact(count)
+            .map_err(|_| err(ErrorKind::ResourceLimit, "frame locals allocation failed"))?;
+        locals.extend_from_slice(args);
+        locals.extend(local_types.iter().map(|ty| Value::zero(*ty)));
+        #[cfg(feature = "performance-counters")]
+        self.perf.record(perf::Event::Frame, 1);
+
+        #[cfg(test)]
+        P032_ARGUMENT_RANGES.with(|hits| hits.set(hits.get().saturating_add(1)));
+        Ok(Frame {
+            function: fun,
+            pc: 0,
+            locals,
+            base,
+            labels: Vec::new(),
         })
     }
