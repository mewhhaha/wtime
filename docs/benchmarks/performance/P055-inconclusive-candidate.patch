@@ -0,0 +1,111 @@
+//! Reversible source-selected shapes for the existing scalar fallback only.
+//! The charged outer loop and prepared numeric/control/memory paths are shared.
+use super::*;
+use super::execute::Step;
+
+#[derive(Clone, Copy)]
+#[allow(dead_code)]
+enum Shape { Split, Handlers }
+const SELECTED: Shape = Shape::Handlers;
+type Handler = fn(CompactOp, &mut [Value], &mut Vec<Value>, &Store) -> Result<Step>;
+
+pub(super) fn execute(op: CompactOp, locals: &mut [Value], stack: &mut Vec<Value>, store: &Store) -> Result<Step> {
+    #[cfg(test)]
+    PATHS.with(|paths| { let mut counts=paths.get(); counts[match SELECTED { Shape::Split=>0,Shape::Handlers=>1 }]+=1; paths.set(counts); });
+    match SELECTED { Shape::Split=>split(op,locals,stack,store),
+        Shape::Handlers=>handlers(op,locals,stack,store) }
+}
+
+fn get(op: CompactOp, locals: &mut [Value], stack: &mut Vec<Value>, _: &Store) -> Result<Step> {
+    stack.push(*locals.get(op.aux as usize).ok_or_else(|| trap("local index"))?);
+    Ok(Step::Continue)
+}
+fn set(op: CompactOp, locals: &mut [Value], stack: &mut Vec<Value>, _: &Store) -> Result<Step> {
+    let value=pop(stack)?;
+    *locals.get_mut(op.aux as usize).ok_or_else(|| trap("local index"))?=value;
+    Ok(Step::Continue)
+}
+fn tee(op: CompactOp, locals: &mut [Value], stack: &mut Vec<Value>, _: &Store) -> Result<Step> {
+    let value=*stack.last().ok_or_else(|| trap("empty stack"))?;
+    *locals.get_mut(op.aux as usize).ok_or_else(|| trap("local index"))?=value;
+    Ok(Step::Continue)
+}
+fn i32_const(op: CompactOp, _: &mut [Value], stack: &mut Vec<Value>, _: &Store) -> Result<Step> {
+    stack.push(Value::I32(op.payload as u32 as i32)); Ok(Step::Continue)
+}
+fn i64_const(op: CompactOp, _: &mut [Value], stack: &mut Vec<Value>, _: &Store) -> Result<Step> {
+    stack.push(Value::I64(op.payload as i64)); Ok(Step::Continue)
+}
+#[cold]
+#[inline(never)]
+fn cold(op: CompactOp, locals: &mut [Value], stack: &mut Vec<Value>, store: &Store) -> Result<Step> {
+    // Calls return an action to the common iterative loop. This calls the
+    // archived scalar match directly, never recursing into selected dispatch.
+    super::execute::original(op,locals,stack,store)
+}
+fn split(op: CompactOp, locals: &mut [Value], stack: &mut Vec<Value>, store: &Store) -> Result<Step> {
+    match op.opcode {
+        0x20=>get(op,locals,stack,store),0x21=>set(op,locals,stack,store),
+        0x22=>tee(op,locals,stack,store),0x41=>i32_const(op,locals,stack,store),
+        0x42=>i64_const(op,locals,stack,store),_=>cold(op,locals,stack,store),
+    }
+}
+const fn table() -> [Handler;256] {
+    let mut table=[cold as Handler;256];
+    table[0x20]=get;table[0x21]=set;table[0x22]=tee;
+    table[0x41]=i32_const;table[0x42]=i64_const;
+    table
+}
+static HANDLERS: [Handler;256]=table();
+fn handlers(op: CompactOp, locals: &mut [Value], stack: &mut Vec<Value>, store: &Store) -> Result<Step> {
+    let handler=HANDLERS.get(usize::from(op.opcode)).copied().unwrap_or(cold);
+    handler(op,locals,stack,store)
+}
+
+#[cfg(test)]
+thread_local! { static PATHS: std::cell::Cell<[u64;2]> = const { std::cell::Cell::new([0;2]) }; }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn action(result: Result<Step>) -> std::result::Result<String,(ErrorKind,String)> {
+        result.map(|step|match step {
+            Step::Continue=>"continue".into(),Step::Return=>"return".into(),
+            Step::Call{index,tail}=>format!("call:{index}:{tail}"),
+            _=>panic!("scalar dispatch emitted an unsupported action"),
+        }).map_err(|error|(error.kind,error.message))
+    }
+    #[test]
+    fn p055_dispatch_shapes_match_original_scalar_operations_and_selected_path() {
+        let engine=Engine::with_execution_policy(Config::default(),ExecutionPolicy::Compact).unwrap();
+        let mut store=Store::new(&engine);
+        for opcode in [1,0x0b,0x0f,0x10,0x12,0x1a,0x1b,0x1c,0x20,0x21,0x22,0x41,0x42,0x45,0x6a,0x6b,0x6c,0x71,0x7f,0xffff] {
+            for aux in [0,1,2,u32::MAX] {
+                for input in [vec![],vec![Value::I32(-37)],vec![Value::I64(i64::MIN)],
+                    vec![Value::I32(i32::MAX),Value::I32(1)],
+                    vec![Value::I32(7),Value::I32(-9),Value::I32(-1)]] {
+                    let op=CompactOp{opcode,form:INDEX,aux,payload:0x80000000ffffffff};
+                    let mut original_stack=input.clone();
+                    let mut original_locals=vec![Value::I32(91),Value::I64(-23)];
+                    let expected=action(super::super::execute::original(op,&mut original_locals,&mut original_stack,&store));
+                    for dispatch in [split as Handler,handlers as Handler] {
+                        let mut stack=input.clone();let mut locals=vec![Value::I32(91),Value::I64(-23)];
+                        assert_eq!(action(dispatch(op,&mut locals,&mut stack,&store)),expected,"opcode {opcode:x}, aux {aux}");
+                        assert_eq!(stack,original_stack);assert_eq!(locals,original_locals);
+                    }
+                }
+            }
+        }
+        // A real invocation proves the compiled selected route is used, rather
+        // than counting direct helper calls in the comparison above.
+        let module=engine.compile(include_bytes!("../../../tests/fixtures/performance/p038/scalar32.wasm")).unwrap();
+        let instance=Linker::new(&engine).instantiate(&mut store,&module).unwrap();
+        let External::Func(run)=instance.export(&store,"run").unwrap() else { panic!() };
+        PATHS.with(|paths|paths.set([0;2]));
+        assert_eq!(store.invoke(run,&[Value::I32(i32::MIN),Value::I32(1)]).unwrap(),RunOutcome::Returned(vec![Value::I32(-2)]));
+        let counts=PATHS.with(|paths|paths.get());
+        let selected=match SELECTED { Shape::Split=>0,Shape::Handlers=>1 };
+        assert!(counts[selected]>0);assert_eq!(counts[1-selected],0);
+        assert_eq!(store.compact_dispatches,14);
+    }
+}
