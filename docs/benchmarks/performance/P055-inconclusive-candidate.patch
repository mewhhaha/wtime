+#![cfg(all(feature="compact-executor",feature="execution-reference"))]
+use wtime_runtime::*;
+const SCALAR: &[u8]=include_bytes!("../fixtures/performance/p038/scalar32.wasm");
+const EFFECTS: &[u8]=include_bytes!("../fixtures/performance/p047/p047_effects_prefix.wasm");
+fn loaded(policy:ExecutionPolicy,config:Config,bytes:&[u8])->(Store,Instance,Func) {
+    let engine=Engine::with_execution_policy(config,policy).unwrap();
+    let module=engine.compile(bytes).unwrap();let mut store=Store::new(&engine);
+    let instance=Linker::new(&engine).instantiate(&mut store,&module).unwrap();
+    let External::Func(run)=instance.export(&store,"run").unwrap() else { panic!() };
+    (store,instance,run)
+}
+fn view(result:Result<RunOutcome>)->std::result::Result<RunOutcome,(ErrorKind,String)> {
+    result.map_err(|error|(error.kind,error.message))
+}
+#[test]
+fn p055_numeric_locals_and_iterative_loops_preserve_source_counts() {
+    for policy in [ExecutionPolicy::Decoded,ExecutionPolicy::Reference,ExecutionPolicy::Compact] {
+        let (mut store,_,run)=loaded(policy,Config::default(),SCALAR);
+        for input in [i32::MIN,i32::MAX,-1,0,1,0x2468ace] {
+            for condition in [0,1,-1] {
+                let before=store.compact_dispatches();
+                let expected=if condition==0 { 7 } else { input.wrapping_add(i32::MAX)^1 };
+                assert_eq!(store.invoke(run,&[Value::I32(input),Value::I32(condition)]).unwrap(),RunOutcome::Returned(vec![Value::I32(expected)]));
+                assert_eq!(store.compact_dispatches()-before,if policy==ExecutionPolicy::Compact { 14 } else { 0 });
+            }
+        }
+        for (bytes,expected) in [
+            (include_bytes!("../fixtures/performance/p047/accumulator.wasm").as_slice(),49995000),
+            (include_bytes!("../fixtures/performance/p047/dependent.wasm").as_slice(),{
+                let mut value=1i32;for _ in 0..10000 { value=value.wrapping_mul(1664525).wrapping_add(1013904223); } value
+            }),
+            (include_bytes!("../fixtures/performance/p050/direct_calls.wasm").as_slice(),{
+                let mut value=1i32;for _ in 0..10000 { value=value.wrapping_mul(3).wrapping_add(1); } value
+            }),
+        ] {
+            let (mut store,_,run)=loaded(policy,Config::default(),bytes);
+            assert_eq!(store.invoke(run,&[Value::I32(10000)]).unwrap(),RunOutcome::Returned(vec![Value::I32(expected)]));
+            if policy==ExecutionPolicy::Compact { assert!(store.compact_dispatches()>10000); }
+        }
+    }
+}
+#[test]
+fn p055_every_fuel_prefix_barrier_and_materialization_remains_canonical() {
+    for (bytes,args,expected,effects) in [
+        (SCALAR,vec![Value::I32(i32::MIN),Value::I32(1)],-2,false),
+        (EFFECTS,vec![Value::I32(i32::MAX)],-2147483642,true),
+    ] {
+        for fuel in 0..=15 {
+            for policy in [ExecutionPolicy::Decoded,ExecutionPolicy::Reference,ExecutionPolicy::Compact] {
+                let mut config=Config::default();config.limits.fuel=Some(fuel);
+                let (mut store,instance,run)=loaded(policy,config,bytes);
+                assert_eq!(view(store.invoke(run,&args)),if fuel<14 {
+                    Err((ErrorKind::ResourceLimit,"fuel exhausted".into()))
+                } else { Ok(RunOutcome::Returned(vec![Value::I32(expected)])) });
+                if effects {
+                    let External::Memory(memory)=instance.export(&store,"memory").unwrap() else { panic!() };
+                    let External::Global(global)=instance.export(&store,"state").unwrap() else { panic!() };
+                    let mut image=vec![0;65536];
+                    if fuel>=3 { image[..4].copy_from_slice(&42i32.to_le_bytes()); }
+                    if fuel>=12 { image[4..8].copy_from_slice(&(-2147483642i32).to_le_bytes()); }
+                    assert_eq!(store.read_memory(memory,0,65536).unwrap(),image);
+                    assert_eq!(store.get_global(global).unwrap(),Value::I32(if fuel>=9 { -2147483642 } else { -19 }));
+                }
+            }
+        }
+        for pc in 0..14 {
+            let mut snapshots=vec![];
+            for policy in [ExecutionPolicy::Decoded,ExecutionPolicy::Compact] {
+                let mut config=Config::default();config.limits.fuel=Some(14);
+                let (mut store,_,run)=loaded(policy,config,bytes);
+                store.request_materialization_roundtrip(run,pc).unwrap();
+                assert_eq!(store.invoke(run,&args).unwrap(),RunOutcome::Returned(vec![Value::I32(expected)]));
+                let snapshot=store.execution_snapshot().unwrap().clone();
+                assert_eq!(snapshot.cursor.source_pc,pc);assert_eq!(snapshot.remaining_fuel,Some(13-pc as u64));
+                assert!(snapshot.pending_boundary_charged);assert_eq!(store.materialization_roundtrips(),1);
+                snapshots.push(snapshot);
+            }
+            assert_eq!(snapshots[0],snapshots[1],"source boundary {pc}");
+        }
+    }
+    // A host callback requests cancellation; the pending store must not run.
+    for policy in [ExecutionPolicy::Decoded,ExecutionPolicy::Compact] {
+        let engine=Engine::with_execution_policy(Config::default(),policy).unwrap();
+        let module=engine.compile(include_bytes!("../fixtures/performance/accounting/host_then_store.wasm")).unwrap();
+        let mut store=Store::new(&engine);let cancellation=store.cancellation_token();
+        let callback=store.create_host_func(FuncType::new(vec![],vec![]),move |_| { cancellation.cancel();Ok(vec![]) }).unwrap();
+        let mut linker=Linker::new(&engine);linker.define("host","stop",External::Func(callback)).unwrap();
+        let instance=linker.instantiate(&mut store,&module).unwrap();
+        let External::Func(run)=instance.export(&store,"run").unwrap() else { panic!() };
+        assert_eq!(store.invoke(run,&[]).unwrap_err().message,"execution cancelled");
+        let External::Memory(memory)=instance.export(&store,"memory").unwrap() else { panic!() };
+        assert_eq!(store.read_memory(memory,0,4).unwrap(),[0,0,0,0]);
+    }
+}
