+#[cfg(test)]
+mod p030_tests {
+    use super::*;
+    fn setup(bytes: &[u8], depth: usize) -> (Store, Instance) {
+        let mut config = Config::default();
+        config.features = FeatureSet::all_phase3_core();
+        config.limits.max_call_depth = depth;
+        let engine = Engine::new(config).unwrap();
+        let module = engine.compile(bytes).unwrap();
+        let mut store = Store::new(&engine);
+        let instance = Linker::new(&engine)
+            .instantiate(&mut store, &module)
+            .unwrap();
+        (store, instance)
+    }
+    fn invoke(
+        store: &mut Store,
+        instance: Instance,
+        name: &str,
+        args: &[Value],
+    ) -> Result<RunOutcome> {
+        let External::Func(function) = instance.export(store, name).unwrap() else {
+            panic!("function");
+        };
+        store.invoke(function, args)
+    }
+    fn reset() {
+        P030_VALIDATED_ENTRIES.with(|count| count.set(0));
+    }
+    fn hits() -> u64 {
+        P030_VALIDATED_ENTRIES.with(std::cell::Cell::get)
+    }
+    #[test]
+    fn p030_actual_scalar_vector_direct_calls_construct_validated_frames() {
+        let (mut store, instance) = setup(
+            include_bytes!("../tests/fixtures/performance/frames/guest_frame.wasm"),
+            16,
+        );
+        reset();
+        for expected_hits in [2, 4] {
+            assert_eq!(
+                invoke(&mut store, instance, "run", &[]).unwrap(),
+                RunOutcome::Returned(vec![Value::I32(84)])
+            );
+            assert_eq!(hits(), expected_hits);
+        }
+        let mut vector = [0u8; 16];
+        for (lane, value) in [-1i32, 0, 17, 99].into_iter().enumerate() {
+            vector[lane * 4..lane * 4 + 4].copy_from_slice(&value.to_le_bytes());
+        }
+        reset();
+        assert_eq!(
+            invoke(&mut store, instance, "echo_run", &[]).unwrap(),
+            RunOutcome::Returned(vec![
+                Value::I32(-17),
+                Value::I64(i64::MAX),
+                Value::F32(0x8000_0000),
+                Value::F64((-2.25f64).to_bits()),
+                Value::V128(V128(vector))
+            ])
+        );
+        assert_eq!(
+            hits(),
+            1,
+            "actual five-value echo uses certified direct entry"
+        );
+    }
+    #[test]
+    fn p030_actual_return_call_keeps_bounded_depth() {
+        let (mut store, instance) = setup(
+            include_bytes!("../tests/fixtures/performance/frames/tail_call.wasm"),
+            2,
+        );
+        reset();
+        assert_eq!(
+            invoke(&mut store, instance, "run", &[]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(42)])
+        );
+        assert_eq!(
+            hits(),
+            2,
+            "ordinary entry plus certified return_call target"
+        );
+    }
+    #[test]
+    fn p030_reference_parameter_direct_call_keeps_checked_fallback() {
+        let (mut store, instance) = setup(
+            include_bytes!("../tests/fixtures/performance/frames/reference_control.wasm"),
+            16,
+        );
+        reset();
+        assert_eq!(
+            invoke(&mut store, instance, "run", &[]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(41)])
+        );
+        assert_eq!(
+            hits(),
+            0,
+            "reference parameters retain full checked frame construction"
+        );
+        let collected = store.collect().unwrap();
+        assert_eq!(collected.reclaimed, 1);
+        assert_eq!(collected.live, 0);
+        assert_eq!(store.gc_payload_bytes(), 0);
+    }
+    #[test]
+    fn p030_direct_import_keeps_host_signature_boundary() {
+        let engine = Engine::new(Config::default()).unwrap();
+        let module = engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/frames/import_control.wasm"
+            ))
+            .unwrap();
+        let mut store = Store::new(&engine);
+        let host = store
+            .create_host_func(
+                FuncType::new(vec![ValType::I32], vec![ValType::I32]),
+                |values| {
+                    let Value::I32(value) = values[0] else {
+                        panic!("checked host argument");
+                    };
+                    Ok(vec![Value::I32(value + 1)])
+                },
+            )
+            .unwrap();
+        let mut linker = Linker::new(&engine);
+        linker.define("env", "bump", External::Func(host)).unwrap();
+        let instance = linker.instantiate(&mut store, &module).unwrap();
+        reset();
+        assert_eq!(
+            invoke(&mut store, instance, "run", &[Value::I32(7)]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(8)])
+        );
+        assert_eq!(
+            hits(),
+            0,
+            "direct host import never requests certified guest frame"
+        );
+        assert_eq!(
+            store.invoke(host, &[Value::I64(7)]).unwrap_err().kind,
+            ErrorKind::Host
+        );
+        assert_eq!(hits(), 0);
+    }
+}
