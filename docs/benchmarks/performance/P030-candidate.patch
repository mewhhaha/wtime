+    // Private to the decoded executor. Only the sealed direct CALL/RETURN_CALL
+    // arm may request this entry; public, host and dynamic calls retain frame().
+    fn validated_direct_guest_frame(
+        &self,
+        f: Func,
+        args: Vec<Value>,
+        base: usize,
+    ) -> Result<Frame> {
+        let k = self.check(f.0, &self.funcs)?;
+        let fun = self.funcs[k].clone();
