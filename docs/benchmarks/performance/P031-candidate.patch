+            .checked_add(
+                self.prompts
+                    .capacity()
+                    .checked_mul(std::mem::size_of::<Prompt>())?,
+            )
+    }
+}
+#[derive(Default)]
+pub(super) struct ActivationPool {
+    idle: Vec<Activation>,
+}
+impl ActivationPool {
+    pub(super) fn take(&mut self) -> Activation {
+        // Move all active ownership out. No pool/RefCell loan crosses a host
+        // callback, and recursive reentry acquires a different activation.
+        self.idle.pop().unwrap_or_default()
+    }
+    pub(super) fn put(&mut self, mut activation: Activation) {
+        activation.clear();
+        let Some(extra) = activation.allocation_bytes() else {
+            return;
+        };
+        if self.idle.len() >= MAX_IDLE || extra == 0 || extra > MAX_IDLE_BYTES {
+            return;
+        }
+        let Some(current) = self.retained_bytes() else {
+            self.idle = Vec::new();
+            return;
+        };
+        if current
+            .checked_add(extra)
+            .is_none_or(|bytes| bytes > MAX_IDLE_BYTES)
+        {
+            return;
+        }
+        if self.idle.try_reserve_exact(1).is_err() {
+            return;
+        }
+        // A reserve may exceed requested capacity; count actual allocations.
+        if self.idle.capacity() > MAX_IDLE {
+            self.idle = Vec::new();
+            return;
+        }
+        let Some(reserved) = self.retained_bytes() else {
+            self.idle = Vec::new();
+            return;
+        };
+        if reserved > MAX_IDLE_BYTES {
+            self.idle = Vec::new();
+            return;
+        }
+        if reserved
+            .checked_add(extra)
+            .is_none_or(|bytes| bytes > MAX_IDLE_BYTES)
+        {
+            return;
+        }
+        self.idle.push(activation);
+    }
+    pub(super) fn retained_bytes(&self) -> Option<usize> {
+        let mut bytes = std::mem::size_of::<Self>().checked_add(
+            self.idle
+                .capacity()
+                .checked_mul(std::mem::size_of::<Activation>())?,
+        )?;
+        for activation in &self.idle {
+            bytes = bytes.checked_add(activation.allocation_bytes()?)?;
+        }
+        Some(bytes)
+    }
+}
+
+pub(super) fn returned_values(stack: &mut Vec<Value>) -> Vec<Value> {
+    if stack.is_empty() {
+        return Vec::new();
+    }
+    if stack
+        .capacity()
+        .checked_mul(std::mem::size_of::<Value>())
+        .is_none_or(|bytes| bytes > MAX_IDLE_BYTES)
+    {
+        return std::mem::take(stack);
+    }
+    let mut result = Vec::new();
+    if result.try_reserve_exact(stack.len()).is_err() {
+        return std::mem::take(stack);
+    }
+    result.extend(stack.drain(..));
+    result
+}
