+// Integration proofs for ownership, cleanup, roots and detached storage.
+#[cfg(test)]
+mod runtime_tests {
+    use super::*;
+    fn engine(depth: usize) -> Engine {
+        let mut config = Config::default();
+        config.features = FeatureSet::all_phase3_core();
+        config.limits.max_call_depth = depth;
+        Engine::new(config).unwrap()
+    }
+    fn load(store: &mut Store, bytes: &[u8]) -> Instance {
+        let e = store.engine.clone();
+        let module = e.compile(bytes).unwrap();
+        Linker::new(&e).instantiate(store, &module).unwrap()
+    }
+    fn function(store: &Store, instance: Instance, name: &str) -> Func {
+        let External::Func(f) = instance.export(store, name).unwrap() else {
+            panic!("function");
+        };
+        f
+    }
+    fn call(
+        store: &mut Store,
+        instance: Instance,
+        name: &str,
+        values: &[Value],
+    ) -> Result<RunOutcome> {
+        store.invoke(function(store, instance, name), values)
+    }
+    fn empty_and_bounded(store: &Store) {
+        assert!(
+            store
+                .activation_pool
+                .idle
+                .iter()
+                .all(|a| a.frames.is_empty() && a.stack.is_empty() && a.prompts.is_empty())
+        );
+        assert!(store.activation_pool.idle.len() <= MAX_IDLE);
+        assert!(store.activation_pool.retained_bytes().unwrap() <= MAX_IDLE_BYTES);
+    }
+    const FRAME: &[u8] = include_bytes!("../tests/fixtures/performance/frames/guest_frame.wasm");
+    #[test]
+    fn p031_real_dispatch_reuses_outer_buffers_without_aliasing_published_results() {
+        let e = engine(16);
+        let mut store = Store::new(&e);
+        let i = load(&mut store, FRAME);
+        let first = call(&mut store, i, "run", &[]).unwrap();
+        assert_eq!(first, RunOutcome::Returned(vec![Value::I32(84)]));
+        empty_and_bounded(&store);
+        assert_eq!(store.activation_pool.idle.len(), 1);
+        let a = &store.activation_pool.idle[0];
+        assert!(a.frames.capacity() > 0 && a.stack.capacity() > 0);
+        let before = (
+            a.frames.as_ptr(),
+            a.frames.capacity(),
+            a.stack.as_ptr(),
+            a.stack.capacity(),
+        );
+        let RunOutcome::Returned(ref values) = first else {
+            panic!("return");
+        };
+        assert_ne!(values.as_ptr(), a.stack.as_ptr());
+        assert_eq!(call(&mut store, i, "run", &[]).unwrap(), first);
+        let a = &store.activation_pool.idle[0];
+        assert_eq!(
+            (
+                a.frames.as_ptr(),
+                a.frames.capacity(),
+                a.stack.as_ptr(),
+                a.stack.capacity()
+            ),
+            before
+        );
+        assert_eq!(values, &[Value::I32(84)]);
+        empty_and_bounded(&store);
+    }
+    #[test]
+    fn p031_real_host_reentry_keeps_outer_allocation_distinct() {
+        let e = engine(16);
+        let mut store = Store::new(&e);
+        let plain = load(&mut store, FRAME);
+        assert_eq!(
+            call(&mut store, plain, "run", &[]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(84)])
+        );
+        let outer_pointer = store.activation_pool.idle[0].frames.as_ptr() as usize;
+        let inner_function = function(&store, plain, "run");
+        let observed = Arc::new(std::sync::Mutex::new(None));
+        let callback_observed = observed.clone();
+        let host = store
+            .create_host_func_with_caller(
+                FuncType::new(vec![ValType::I32], vec![ValType::I32]),
+                move |caller, args| {
+                    assert!(
+                        caller.store.activation_pool.idle.is_empty(),
+                        "outer owns the seeded activation"
+                    );
+                    assert!(
+                        caller
+                            .store
+                            .active_roots
+                            .iter()
+                            .any(|roots| roots.contains(&Value::I32(5)))
+                    );
+                    assert_eq!(
+                        caller.store.invoke(inner_function, &[]).unwrap(),
+                        RunOutcome::Returned(vec![Value::I32(84)])
+                    );
+                    empty_and_bounded(caller.store);
+                    let inner_pointer =
+                        caller.store.activation_pool.idle[0].frames.as_ptr() as usize;
+                    assert_ne!(
+                        inner_pointer, outer_pointer,
+                        "outer live buffer cannot be reused by nested execution"
+                    );
+                    *callback_observed.lock().unwrap() = Some(inner_pointer);
+                    for _ in 0..1024 {
+                        caller
+                            .store
+                            .create_host_func(FuncType::new(vec![], vec![]), |_| Ok(vec![]))
+                            .unwrap();
+                    }
+                    assert_eq!(caller.store.collect().unwrap().live, 0);
+                    let Value::I32(n) = args[0] else {
+                        panic!("argument");
+                    };
+                    Ok(vec![Value::I32(n + 1)])
+                },
+            )
+            .unwrap();
+        let module = e
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/calls/imported-direct.wasm"
+            ))
+            .unwrap();
+        let mut linker = Linker::new(&e);
+        linker.define("host", "bump", External::Func(host)).unwrap();
+        let i = linker.instantiate(&mut store, &module).unwrap();
+        assert_eq!(
+            call(&mut store, i, "run", &[Value::I32(5)]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(10)])
+        );
+        empty_and_bounded(&store);
+        assert_eq!(store.activation_pool.idle.len(), 2);
+        let pointers = store
+            .activation_pool
+            .idle
+            .iter()
+            .map(|a| a.frames.as_ptr() as usize)
+            .collect::<Vec<_>>();
+        assert!(pointers.contains(&outer_pointer));
+        assert!(pointers.contains(&observed.lock().unwrap().unwrap()));
+    }
