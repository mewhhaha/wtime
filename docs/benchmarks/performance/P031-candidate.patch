+#[cfg(test)]
+mod pool_tests {
+    use super::*;
+    #[test]
+    fn p031_idle_activation_reuses_empty_outer_stack_allocation() {
+        let mut pool = ActivationPool::default();
+        let mut active = pool.take();
+        active.stack.try_reserve_exact(8).unwrap();
+        active.stack.extend([Value::I32(7), Value::I64(-9)]);
+        let stack_ptr = active.stack.as_ptr();
+        let stack_capacity = active.stack.capacity();
+        active.stack.clear();
+        assert!(active.stack.is_empty());
+        pool.put(active);
+
+        assert_eq!(pool.idle.len(), 1);
+        let reused = pool.take();
+        assert!(reused.stack.is_empty());
+        assert_eq!(reused.stack.capacity(), stack_capacity);
+        assert_eq!(reused.stack.as_ptr(), stack_ptr);
+    }
+
+    #[test]
+    fn p031_retained_bytes_include_pool_header_idle_slots_and_all_outer_capacities() {
+        let mut pool = ActivationPool::default();
+        let mut activation = pool.take();
+        activation.frames.try_reserve_exact(3).unwrap();
+        activation.stack.try_reserve_exact(7).unwrap();
+        activation.prompts.try_reserve_exact(2).unwrap();
+        activation.stack.push(Value::I32(1));
+        activation.stack.clear();
+        pool.put(activation);
+        assert_eq!(
+            pool.idle.len(),
+            1,
+            "the admitted activation must contribute to retained-byte accounting"
+        );
+
+        let outer_bytes = pool
+            .idle
+            .iter()
+            .map(|activation| {
+                activation.frames.capacity() * std::mem::size_of::<Frame>()
+                    + activation.stack.capacity() * std::mem::size_of::<Value>()
+                    + activation.prompts.capacity() * std::mem::size_of::<Prompt>()
+            })
+            .sum::<usize>();
+        let expected = std::mem::size_of::<ActivationPool>()
+            + pool.idle.capacity() * std::mem::size_of::<Activation>()
+            + outer_bytes;
+        assert_eq!(pool.retained_bytes(), Some(expected));
+        assert!(pool.idle.iter().all(|activation| {
+            activation.frames.is_empty()
+                && activation.stack.is_empty()
+                && activation.prompts.is_empty()
+        }));
+    }
+
+    #[test]
+    fn p031_returned_values_keep_bits_and_ownership_after_pool_put_and_take() {
+        let mut activation = Activation::default();
+        activation.stack.extend([
+            Value::I32(i32::MIN),
+            Value::I64(i64::MAX),
+            Value::F32(0x7fc1_2345),
+            Value::F64(0xfff8_1234_5678_9abc),
+        ]);
+        let source_ptr = activation.stack.as_ptr();
+        let returned = returned_values(&mut activation.stack);
+        assert!(activation.stack.is_empty());
+        let expected = vec![
+            Value::I32(i32::MIN),
+            Value::I64(i64::MAX),
+            Value::F32(0x7fc1_2345),
+            Value::F64(0xfff8_1234_5678_9abc),
+        ];
+        assert_eq!(returned, expected);
+        assert_ne!(returned.as_ptr(), source_ptr);
+
+        let mut pool = ActivationPool::default();
+        pool.put(activation);
+        let next = pool.take();
+        assert!(next.stack.is_empty());
+        assert_eq!(returned, expected);
+    }
+
+    #[test]
+    fn p031_oversized_outer_buffer_is_declined_from_idle_pool() {
+        let mut pool = ActivationPool::default();
+        let mut activation = pool.take();
+        let slots = MAX_IDLE_BYTES / std::mem::size_of::<Value>() + 1;
+        activation.stack.try_reserve_exact(slots).unwrap();
+        assert!(activation.allocation_bytes().unwrap() > MAX_IDLE_BYTES);
+        pool.put(activation);
+        assert!(pool.idle.is_empty());
+        assert_eq!(
+            pool.retained_bytes(),
+            Some(std::mem::size_of::<ActivationPool>())
+        );
+    }
+
+    #[test]
+    fn p031_overlapping_takes_never_alias_active_outer_allocations() {
+        let mut pool = ActivationPool::default();
+        let mut first = pool.take();
+        first.stack.try_reserve_exact(4).unwrap();
+        first.stack.push(Value::I32(11));
+        first.stack.clear();
+        let first_ptr = first.stack.as_ptr();
+
+        let mut second = pool.take();
+        second.stack.try_reserve_exact(4).unwrap();
+        second.stack.push(Value::I32(22));
+        second.stack.clear();
+        let second_ptr = second.stack.as_ptr();
+        assert_ne!(first_ptr, second_ptr);
+
+        pool.put(first);
+        pool.put(second);
+        assert_eq!(pool.idle.len(), 2);
+        assert!(
+            pool.idle
+                .iter()
+                .all(|activation| activation.stack.is_empty())
+        );
+    }
+}
