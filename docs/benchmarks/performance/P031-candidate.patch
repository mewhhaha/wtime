+    #[test]
+    fn p031_caught_exception_result_root_survives_idle_pool_then_reclaims() {
+        let e = engine(16);
+        let mut store = Store::new(&e);
+        let i = load(
+            &mut store,
+            include_bytes!("../tests/fixtures/exception_root/caught_ref_to_function.wasm"),
+        );
+        let RunOutcome::Returned(values) = call(&mut store, i, "run", &[]).unwrap() else {
+            panic!("caught return");
