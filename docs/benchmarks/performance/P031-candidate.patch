+    #[test]
+    fn p031_detached_continuation_survives_source_pool_reuse() {
+        let e = engine(16);
+        let mut store = Store::new(&e);
+        let provider = load(
+            &mut store,
+            include_bytes!(
+                "../../../tools/wtime-bench/fixtures/integration/cross_module_provider.wasm"
+            ),
