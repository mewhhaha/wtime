+mod p024_tests {
+    use super::*;
+    #[test]
+    fn p024_keep_overlap_retains_exact_order_and_allocation() {
+        let mut stack = vec![Value::I32(99), Value::I32(7), Value::I64(9)];
+        let pointer = stack.as_ptr();
+        let capacity = stack.capacity();
+        keep(&mut stack, 0, 2).unwrap();
+        assert_eq!(stack, [Value::I32(7), Value::I64(9)]);
+        assert_eq!(stack.as_ptr(), pointer);
+        assert_eq!(stack.capacity(), capacity);
+        keep(&mut stack, 1, 0).unwrap();
+        assert_eq!(stack, [Value::I32(7)]);
+        let pointer = stack.as_ptr();
+        keep(&mut stack, 1, 0).unwrap();
+        assert_eq!(stack.as_ptr(), pointer);
+    }
+    #[test]
+    fn p024_keep_invalid_ranges_are_transactional() {
+        for (height, results) in [(0, 4), (2, 2), (usize::MAX, 0), (0, usize::MAX)] {
+            let mut stack = vec![Value::I32(99), Value::I32(7), Value::I64(9)];
+            let before = stack.clone();
+            let pointer = stack.as_ptr();
+            let capacity = stack.capacity();
+            let error = keep(&mut stack, height, results).unwrap_err();
+            assert_eq!(error.kind, ErrorKind::Trap);
+            assert_eq!(error.message, "stack underflow");
+            assert_eq!(stack, before);
+            assert_eq!(stack.as_ptr(), pointer);
+            assert_eq!(stack.capacity(), capacity);
+        }
+    }
+}
