+mod p024_capacity_tests {
+    use super::*;
+    #[test]
+    fn p024_captured_labels_report_actual_capacity_at_multiple_depths() {
+        let engine = Engine::new(Config {
+            features: FeatureSet::all_phase3_core(),
+            ..Config::default()
+        })
+        .unwrap();
+        for (depth, bytes) in [
+            (
+                1,
+                include_bytes!("../tests/fixtures/performance/branch/try_table_depth_1.wasm")
+                    .as_slice(),
+            ),
+            (
+                4,
+                include_bytes!("../tests/fixtures/performance/branch/try_table_depth_4.wasm")
+                    .as_slice(),
+            ),
+            (
+                5,
+                include_bytes!("../tests/fixtures/performance/branch/try_table_depth_5.wasm")
+                    .as_slice(),
+            ),
+        ] {
+            let module = engine.compile(bytes).unwrap();
+            let mut store = Store::new(&engine);
+            let instance = Linker::new(&engine)
+                .instantiate(&mut store, &module)
+                .unwrap();
+            let External::Func(function) = instance.export(&store, "run").unwrap() else {
+                panic!()
+            };
+            assert!(matches!(
+                store.invoke(function, &[]).unwrap(),
+                RunOutcome::Suspended { .. }
+            ));
+            let state = store
+                .continuations
+                .values()
+                .find(|state| matches!(state.body, Some(Body::Segment(_))))
+                .unwrap();
+            let Some(Body::Segment(segment)) = &state.body else {
+                panic!()
+            };
+            assert_eq!(segment.frames.len(), 1);
+            let labels = &segment.frames[0].labels;
+            assert_eq!(labels.len(), depth + 1);
+            assert!(labels.capacity() >= labels.len());
+            assert_eq!(
+                labels
+                    .iter()
+                    .filter(|label| label.catch_pc.is_some())
+                    .count(),
+                depth
+            );
+            #[cfg(feature = "execution-reference")]
+            assert!(labels.iter().all(|label| label.catches.capacity() == 0));
+            println!(
+                "depth {depth}: label len={} capacity={} record_bytes={} total_capture_bytes={}",
+                labels.len(),
+                labels.capacity(),
+                std::mem::size_of::<crate::execution::Label>(),
+                store.continuation_bytes()
+            );
+        }
+    }
