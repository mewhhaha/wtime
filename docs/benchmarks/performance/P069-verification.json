            "-B",
            "{repo}/tools/verification/producers/candidate_freeze.py",
            "--manifest",
            "{repo}/docs/benchmarks/performance/P069-selection.json",
            "--predecessor",
            "{repo}/target/performance/P069-before/manifest.json",
            "--frozen",
            "{repo}/target/performance/P069/selection-freeze.json",
            "--output",
            "{stage}/selection.json"
          ]
        }
      ],
      "outputs": {
        "selection": "{stage}/selection.json"
      },
      "checks": [
        {
          "artifact": "selection",
          "pointer": "/schema",
          "op": "equal",
          "value": "wtime-candidate-selection-freeze-v1"
        },
        {
          "artifact": "selection",
          "pointer": "/predecessor_path",
          "op": "equal",
          "value": "/workspace/wtime/target/performance/P069-before/manifest.json"
