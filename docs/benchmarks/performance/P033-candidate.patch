+// Unbuilt P033 candidate: checked by the parent only after predecessor gates.
+
+const SLOTS: usize = 64;
+const BYTE_LIMIT: usize = 8192;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Key {
+    actual: CanonicalTypeId,
+    expected: CanonicalTypeId,
+    exact: bool,
+    budget: usize,
+}
+
+#[cfg(test)]
+mod p033_tests {
+    use super::*;
+    use std::sync::atomic::Ordering::Relaxed;
+
+    fn registry(engine: u64, chain: usize) -> Arc<std::sync::Mutex<CanonicalTypes>> {
+        let mut types = CanonicalTypes::new(engine);
+        // These unit records test the query layer independently of interning;
+        // ordinary canonical interning/collision tests remain required too.
+        for index in 0..chain {
+            types.entries.push(Entry {
+                definition: SubType {
+                    final_: false,
+                    supertype: None,
+                    composite: CompositeType::Func(FuncType {
+                        params: vec![],
+                        results: vec![],
+                    }),
+                    descriptor: None,
+                    describes: None,
+                },
+                supertype: index
+                    .checked_sub(1)
+                    .map(|parent| CanonicalTypeId::test(engine, parent as u32)),
+            });
+        }
+        // One unrelated root gives completed false answers without walking the
+        // long chain; its index is precisely `chain`.
+        types.entries.push(Entry {
+            definition: SubType {
+                final_: false,
+                supertype: None,
+                composite: CompositeType::Func(FuncType {
+                    params: vec![ValType::I32],
+                    results: vec![],
+                }),
+                descriptor: None,
+                describes: None,
+            },
+            supertype: None,
+        });
+        Arc::new(std::sync::Mutex::new(types))
+    }
+
+    #[test]
+    fn p033_exact_equal_and_invalid_identity_are_checked_before_hits() {
+        let types = registry(71, 129);
+        let cache = SubtypeCache::new(71, types.clone());
+        let root = CanonicalTypeId::test(71, 0);
+        let child = CanonicalTypeId::test(71, 128);
+        assert!(cache.query(child, root, false, 128).unwrap());
+        assert!(cache.query(child, root, false, 128).unwrap());
+        assert_eq!(cache.hits.load(Relaxed), 1);
+        assert!(!cache.query(child, root, true, 0).unwrap());
+        assert!(cache.query(child, child, false, 0).unwrap());
+        assert!(cache.query(child, child, true, 0).unwrap());
+        for (actual, expected) in [
+            (CanonicalTypeId::test(72, 128), root),
+            (child, CanonicalTypeId::test(72, 0)),
+            (CanonicalTypeId::test(71, 130), root),
+            (child, CanonicalTypeId::test(71, 130)),
+        ] {
+            let error = cache.query(actual, expected, false, 128).unwrap_err();
+            assert_eq!(error.kind, ErrorKind::Host);
+            assert_eq!(error.message, "foreign or unknown canonical type");
+        }
+        assert_eq!(cache.hits.load(Relaxed), 1);
+    }
+
+    #[test]
+    fn p033_cached_true_and_false_never_bypass_a_lower_work_budget() {
+        let types = registry(73, 129);
+        let cache = SubtypeCache::new(73, types.clone());
+        let root = CanonicalTypeId::test(73, 0);
+        let child = CanonicalTypeId::test(73, 128);
+        let unrelated = CanonicalTypeId::test(73, 129);
+        for _ in 0..2 {
+            assert!(cache.query(child, root, false, 128).unwrap());
+        }
+        for _ in 0..2 {
+            let error = cache.query(child, root, false, 127).unwrap_err();
+            assert_eq!(error.kind, ErrorKind::ResourceLimit);
+            assert_eq!(error.message, "subtype work limit");
+        }
+        for _ in 0..2 {
+            assert!(!cache.query(unrelated, root, false, 1).unwrap());
+        }
+        for _ in 0..2 {
+            assert_eq!(
+                cache.query(unrelated, root, false, 0).unwrap_err().message,
+                "subtype work limit"
+            );
+        }
+        assert_eq!(cache.hits.load(Relaxed), 2);
+        assert_eq!(cache.misses.load(Relaxed), 6);
+    }
+
+    #[test]
+    fn p033_pair_churn_is_bounded_and_collision_eviction_is_deterministic() {
+        let types = registry(79, 513);
+        let cache = SubtypeCache::new(79, types.clone());
+        let root = CanonicalTypeId::test(79, 0);
+        for index in 1..513 {
+            assert!(
+                cache
+                    .query(CanonicalTypeId::test(79, index), root, false, 512)
+                    .unwrap()
+            );
+            assert!(cache.retained_bytes() <= BYTE_LIMIT);
+        }
+        assert_eq!(cache.entries.lock().unwrap().len(), SLOTS);
+        let first = Key {
+            actual: CanonicalTypeId::test(79, 1),
+            expected: root,
+            exact: false,
+            budget: 512,
+        };
+        let second = (2..513)
+            .map(|index| Key {
+                actual: CanonicalTypeId::test(79, index),
+                ..first
+            })
+            .find(|key| key.slot() == first.slot())
+            .unwrap();
+        cache.query(first.actual, root, false, 512).unwrap();
+        cache.query(second.actual, root, false, 512).unwrap();
+        let before = cache.misses.load(Relaxed);
+        cache.query(first.actual, root, false, 512).unwrap();
+        assert_eq!(cache.misses.load(Relaxed), before + 1);
+        assert_eq!(
+            cache.entries.lock().unwrap()[first.slot()]
+                .unwrap()
+                .key
+                .actual,
+            first.actual
+        );
+    }
+
+    #[test]
+    fn p033_unavailable_cache_lock_falls_back_without_deadlocking_or_caching_error() {
+        let types = registry(83, 129);
+        let cache = SubtypeCache::new(83, types.clone());
+        let guard = cache.entries.lock().unwrap();
+        let child = CanonicalTypeId::test(83, 128);
+        let root = CanonicalTypeId::test(83, 0);
+        assert!(cache.query(child, root, false, 128).unwrap());
+        assert_eq!(
+            cache.query(child, root, false, 127).unwrap_err().kind,
+            ErrorKind::ResourceLimit
+        );
+        assert!(guard.is_empty());
+        drop(guard);
+        assert!(cache.query(child, root, false, 128).unwrap());
+        assert!(cache.query(child, root, false, 128).unwrap());
+        assert_eq!(cache.hits.load(Relaxed), 1);
+    }
+
+    #[test]
+    fn p033_append_only_prefix_admits_new_ids_but_preserves_poison_errors() {
+        let types = registry(89, 129);
+        let cache = SubtypeCache::new(89, types.clone());
+        let root = CanonicalTypeId::test(89, 0);
+        let child = CanonicalTypeId::test(89, 128);
+        assert!(cache.query(child, root, false, 128).unwrap());
+        assert!(cache.query(child, root, false, 128).unwrap());
+        assert_eq!(cache.validated_prefix.load(Relaxed), 130);
+        {
+            let mut registry = types.lock().unwrap();
+            let definition = registry.entries[0].definition.clone();
+            registry.entries.push(Entry {
+                definition,
+                supertype: Some(root),
+            });
+        }
+        let new_id = CanonicalTypeId::test(89, 130);
+        assert!(cache.query(new_id, root, false, 1).unwrap());
+        assert_eq!(cache.validated_prefix.load(Relaxed), 131);
+        let poison = types.clone();
+        assert!(
+            std::thread::spawn(move || {
+                let _guard = poison.lock().unwrap();
+                panic!("deliberate registry poison");
+            })
+            .join()
+            .is_err()
+        );
+        for (actual, expected) in [
+            (child, root),
+            (child, child),
+            (CanonicalTypeId::test(90, 128), root),
+        ] {
+            let error = cache.query(actual, expected, false, 128).unwrap_err();
+            assert_eq!(error.kind, ErrorKind::Host);
+            assert_eq!(error.message, "canonical registry poisoned");
+        }
+        assert_eq!(cache.hits.load(Relaxed), 1);
+    }
+}
+#[derive(Clone, Copy)]
+struct Cached {
+    key: Key,
+    answer: bool,
+}
+
+pub(super) struct SubtypeCache {
+    // Bound once to the Store's immutable Engine registry; this Arc cannot be
+    // substituted by a query caller. The registry never removes entries.
+    owner: u64,
+    registry: Arc<std::sync::Mutex<CanonicalTypes>>,
+    validated_prefix: std::sync::atomic::AtomicUsize,
+    entries: std::sync::Mutex<Vec<Option<Cached>>>,
+    #[cfg(test)]
+    hits: std::sync::atomic::AtomicU64,
+    #[cfg(test)]
+    misses: std::sync::atomic::AtomicU64,
+}
+
+impl Key {
+    fn slot(self) -> usize {
+        let mut hash = self.actual.engine ^ self.expected.engine.rotate_left(17);
+        hash ^= u64::from(self.actual.index).wrapping_mul(0x9e3779b185ebca87);
+        hash ^= u64::from(self.expected.index).rotate_left(31);
+        hash ^= (self.budget as u64).rotate_left(11);
+        hash ^= u64::from(self.exact).wrapping_mul(0xd6e8feb86659fd93);
+        (hash as usize) & (SLOTS - 1)
+    }
+}
+
+impl SubtypeCache {
+    pub(super) fn new(owner: u64, registry: Arc<std::sync::Mutex<CanonicalTypes>>) -> Self {
+        Self {
+            owner,
+            registry,
+            validated_prefix: std::sync::atomic::AtomicUsize::new(0),
+            entries: std::sync::Mutex::new(Vec::new()),
+            #[cfg(test)]
+            hits: std::sync::atomic::AtomicU64::new(0),
+            #[cfg(test)]
+            misses: std::sync::atomic::AtomicU64::new(0),
+        }
+    }
+
+    pub(super) fn query(
+        &self,
+        actual: CanonicalTypeId,
+        expected: CanonicalTypeId,
+        exact: bool,
+        budget: usize,
+    ) -> Result<bool> {
+        // Preserve registry-poison error priority even on established hits.
+        if self.registry.is_poisoned() {
+            return Err(err(ErrorKind::Host, "canonical registry poisoned"));
+        }
+        // Check both complete identities before a hit. An established prefix
+        // is a certificate for this fixed append-only registry, never a guess
+        // about the current function/table target. New indices are validated
+        // under its lock before extending the certificate.
+        if actual.engine != self.owner || expected.engine != self.owner {
+            return Err(err(ErrorKind::Host, "foreign or unknown canonical type"));
+        }
+        let prefix = self
+            .validated_prefix
+            .load(std::sync::atomic::Ordering::Acquire);
+        if actual.index as usize >= prefix || expected.index as usize >= prefix {
+            let types = self
+                .registry
+                .lock()
+                .map_err(|_| err(ErrorKind::Host, "canonical registry poisoned"))?;
+            types.check(actual)?;
+            types.check(expected)?;
+            self.validated_prefix
+                .store(types.entries.len(), std::sync::atomic::Ordering::Release);
+        }
+        if exact || actual == expected {
+            return Ok(actual == expected);
+        }
+        let key = Key {
+            actual,
+            expected,
+            exact,
+            budget,
+        };
+        let slot = key.slot();
+        let cached = self
+            .entries
+            .try_lock()
+            .ok()
+            .and_then(|entries| entries.get(slot).copied().flatten());
+        if let Some(entry) = cached.filter(|entry| entry.key == key) {
+            #[cfg(test)]
+            self.hits.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            return Ok(entry.answer);
+        }
+        #[cfg(test)]
+        self.misses
+            .fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        // Propagate errors before insertion: exhausted work is never a cached
+        // false answer, and a lower budget is a distinct query.
+        let answer = self
+            .registry
+            .lock()
+            .map_err(|_| err(ErrorKind::Host, "canonical registry poisoned"))?
+            .is_subtype(actual, expected, exact, budget)?;
+        if let Ok(mut entries) = self.entries.try_lock() {
+            if entries.is_empty() {
+                let mut candidate = Vec::new();
+                if candidate.try_reserve_exact(SLOTS).is_ok() {
+                    let bytes = candidate
+                        .capacity()
+                        .checked_mul(std::mem::size_of::<Option<Cached>>())
+                        .and_then(|bytes| bytes.checked_add(std::mem::size_of::<Self>()));
+                    if bytes.is_some_and(|bytes| bytes <= BYTE_LIMIT) {
+                        candidate.resize(SLOTS, None);
+                        *entries = candidate;
+                    }
+                }
+            }
+            if let Some(entry) = entries.get_mut(slot) {
+                *entry = Some(Cached { key, answer });
+            }
+        }
+        Ok(answer)
+    }
+
+    #[cfg(test)]
+    fn retained_bytes(&self) -> usize {
+        std::mem::size_of::<Self>()
+            + self.entries.lock().unwrap().capacity() * std::mem::size_of::<Option<Cached>>()
+    }
+
+    #[cfg(test)]
+    pub(super) fn test_counts(&self) -> (u64, u64, usize) {
+        use std::sync::atomic::Ordering::Relaxed;
+        (
+            self.hits.load(Relaxed),
+            self.misses.load(Relaxed),
+            self.retained_bytes(),
+        )
+    }
+}
