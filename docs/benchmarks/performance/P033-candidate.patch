+#[cfg(test)]
+mod p033_store_tests {
+    use super::*;
+
+    #[test]
+    fn p033_actual_indirect_dispatch_hits_cache_without_freezing_table_target() {
+        let engine = Engine::new(Config {
+            features: FeatureSet::all_phase3_core(),
+            ..Config::default()
+        })
+        .unwrap();
+        let module = engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/gc/changed_indirect_target.wasm"
+            ))
+            .unwrap();
+        let mut store = Store::new(&engine);
+        let instance = Linker::new(&engine)
+            .instantiate(&mut store, &module)
+            .unwrap();
+        let run = match instance.export(&store, "run").unwrap() {
+            External::Func(f) => f,
+            _ => panic!(),
+        };
+        for _ in 0..2 {
+            assert_eq!(
+                store.invoke(run, &[]).unwrap(),
+                RunOutcome::Returned(vec![Value::I32(11)])
+            );
+        }
+        let (hits, misses, bytes) = store.subtype_cache.test_counts();
+        assert_eq!((hits, misses), (1, 1));
+        assert!(bytes <= 8192);
+        let set_second = match instance.export(&store, "set_second").unwrap() {
+            External::Func(f) => f,
+            _ => panic!(),
+        };
+        store.invoke(set_second, &[]).unwrap();
+        assert_eq!(
+            store.invoke(run, &[]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(22)])
+        );
+        let set_bad = match instance.export(&store, "set_bad").unwrap() {
+            External::Func(f) => f,
+            _ => panic!(),
+        };
+        store.invoke(set_bad, &[]).unwrap();
+        for _ in 0..2 {
+            let error = store.invoke(run, &[]).unwrap_err();
+            assert_eq!(error.kind, ErrorKind::Trap);
+            assert_eq!(error.trap_code, Some(TrapCode::IndirectCallTypeMismatch));
+        }
+        assert_eq!(store.subtype_cache.test_counts().0, 2);
+        let set_first = match instance.export(&store, "set_first").unwrap() {
+            External::Func(f) => f,
+            _ => panic!(),
+        };
+        store.invoke(set_first, &[]).unwrap();
+        assert_eq!(
+            store.invoke(run, &[]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(11)])
+        );
+        assert_eq!(store.subtype_cache.test_counts().0, 3);
+        // The second Store shares the canonical registry, but no cache entries.
+        let other = Store::new(&engine);
+        assert_eq!(other.subtype_cache.test_counts().0, 0);
+        assert_eq!(other.subtype_cache.test_counts().1, 0);
+    }
