+#[cfg(test)]
+mod p029_tests {
+    use super::*;
+    #[test]
+    fn p029_multiple_frames_share_signature_owner_across_arena_growth() {
+        let engine = Engine::new(Config {
+            features: FeatureSet::all_phase3_core(),
+            ..Config::default()
+        })
+        .unwrap();
+        let module = engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/calls/direct-recursive-multivalue.wasm"
+            ))
+            .unwrap();
+        let mut store = Store::new(&engine);
+        let instance = Linker::new(&engine)
+            .instantiate(&mut store, &module)
+            .unwrap();
+        let function = instance.function(&store, 0).unwrap();
+        let frame_a = store
+            .frame(function, vec![Value::I32(64), Value::I64(5)], 0)
+            .unwrap();
+        let frame_b = store
+            .frame(function, vec![Value::I32(32), Value::I64(6)], 0)
+            .unwrap();
+        let original = &store.funcs[function.0.index].metadata;
+        assert!(Arc::ptr_eq(original, &frame_a.function.metadata));
+        assert!(Arc::ptr_eq(original, &frame_b.function.metadata));
+        assert_eq!(
+            frame_a.function.ty.params.as_ptr(),
+            frame_b.function.ty.params.as_ptr()
+        );
+        for _ in 0..1024 {
+            store
+                .create_host_func(FuncType::new(vec![], vec![]), |_| Ok(vec![]))
+                .unwrap();
+        }
+        drop(module);
+        assert!(Arc::ptr_eq(
+            &store.funcs[function.0.index].metadata,
+            &frame_a.function.metadata
+        ));
+        assert_eq!(frame_a.function.ty.params, [ValType::I32, ValType::I64]);
+        assert_eq!(frame_a.function.ty.results, [ValType::I32, ValType::I64]);
+    }
+    #[test]
+    fn p029_invalid_internal_function_handle_still_fails_checked_entry() {
+        let engine = Engine::new(Config::default()).unwrap();
+        let mut store = Store::new(&engine);
+        let invalid = Func(store.h(store.funcs.len()));
+        assert_eq!(
+            store.invoke(invalid, &[]).unwrap_err().kind,
+            ErrorKind::Host
+        );
+        let valid = store
+            .create_host_func(FuncType::new(vec![], vec![]), |_| Ok(vec![]))
+            .unwrap();
+        let mut stale = valid;
+        stale.0.generation = stale.0.generation.wrapping_add(1);
+        assert_eq!(store.invoke(stale, &[]).unwrap_err().kind, ErrorKind::Host);
+    }
+    #[test]
+    fn p029_real_guest_frames_share_signature_during_host_reentry() {
+        let engine = Engine::new(Config::default()).unwrap();
+        let module = engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/calls/imported-direct.wasm"
+            ))
+            .unwrap();
+        let mut store = Store::new(&engine);
+        let owners = Arc::new(std::sync::Mutex::new(Vec::<(
+            Func,
+            std::sync::Weak<FunctionMetadata>,
+            usize,
+        )>::new()));
+        let callback_owners = owners.clone();
+        let host = store
+            .create_host_func_with_caller(
+                FuncType::new(vec![ValType::I32], vec![ValType::I32]),
+                move |caller, arguments| {
+                    let expected = callback_owners.lock().unwrap().clone();
+                    assert_eq!(expected.len(), 2);
+                    for _ in 0..1024 {
+                        caller
+                            .store
+                            .create_host_func(FuncType::new(vec![], vec![]), |_| Ok(vec![]))
+                            .unwrap();
+                    }
+                    for (function, weak, params_pointer) in expected {
+                        let k = caller.store.check(function.0, &caller.store.funcs).unwrap();
+                        let metadata = &caller.store.funcs[k].metadata;
+                        assert!(std::sync::Weak::ptr_eq(&weak, &Arc::downgrade(metadata)));
+                        // Weak expectations own no strong handles. The Store arena
+                        // and an actually active guest frame each retain one owner.
+                        assert!(Arc::strong_count(metadata) >= 2);
+                        assert_eq!(metadata.ty.params.as_ptr() as usize, params_pointer);
+                    }
+                    let Value::I32(value) = arguments[0] else {
+                        panic!("i32 host argument");
+                    };
+                    Ok(vec![Value::I32(value + 1)])
+                },
+            )
+            .unwrap();
+        let mut linker = Linker::new(&engine);
+        linker.define("host", "bump", External::Func(host)).unwrap();
+        let instance = linker.instantiate(&mut store, &module).unwrap();
+        for index in [1, 2] {
+            let function = instance.function(&store, index).unwrap();
+            let metadata = &store.funcs[function.0.index].metadata;
+            owners.lock().unwrap().push((
+                function,
+                Arc::downgrade(metadata),
+                metadata.ty.params.as_ptr() as usize,
+            ));
+        }
+        let External::Func(run) = instance.export(&store, "run").unwrap() else {
+            panic!("run");
+        };
+        assert_eq!(
+            store.invoke(run, &[Value::I32(5)]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(10)])
+        );
+        for (_, weak, _) in owners.lock().unwrap().iter() {
+            assert_eq!(
+                weak.strong_count(),
+                1,
+                "active frames released their metadata owners"
+            );
+        }
+    }
