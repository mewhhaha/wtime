{
  "schema_version": 1,
  "task": "P124",
  "identities": {
    "checker": {
      "paths": [
        "tools/wtime-bench/p046_gate.py",
        "tools/wtime-bench/tests/test_p124_portfolio.py",
        "tools/wtime-bench/tests/test_p046_compact_gate.py",
        "tools/wtime-bench/workloads.py",
        "tools/wtime-bench/workloads.json",
        "tools/wtime-bench/analyze.py",
        "tools/wtime-bench/bootstrap.py",
        "tools/wtime-bench/tests/test_p124_bootstrap.py",
        "tools/wtime-bench/compare.py",
        "tools/wtime-bench/baseline.py",
        "tools/wtime-bench/p123_adapter.py",
        "tools/wtime-bench/gates.py",
        "tools/verification/producers/p121.py",
        "tools/verification/producers/p123.py",
        "tools/checks/build_budget.py",
        "tools/checks/dependency_budget.py",
        "tools/verification/statistics.py"
      ]
    },
    "policy": {
      "paths": ["docs/benchmarks/performance/P124-contract.json"]
    }
  },
  "stages": {
    "verify": {
      "uses": ["checker", "policy"],
      "commands": [
        {
          "name": "matrix-tests",
          "argv": [
            "{python}", "-B", "-m", "unittest", "discover",
            "-s", "tools/wtime-bench/tests", "-p", "test_p124*.py", "-v"
          ]
        },
        {
          "name": "portfolio-tests",
          "argv": [
            "{python}", "-B", "-m", "unittest", "discover",
            "-s", "tools/wtime-bench/tests", "-p", "test_p046*.py", "-v"
          ]
        }
      ],
      "tests": [
        {
          "command": "matrix-tests",
          "kind": "unittest",
          "synthetic": true,
          "required_names": [
            "test_p124_rank_distribution_matches_all_even_and_odd_resamples",
            "test_p124_rank_sampler_is_seeded_and_preserves_constant_medians",
            "test_p124_large_groups_keep_explicit_bootstrap_and_reject_bad_counts",
            "test_p124_primary_family_uses_equal_workload_weights",
            "test_p124_full_four_family_two_baseline_matrix_counts_exactly",
            "test_p124_missing_family_workload_stage_run_or_pair_fails_closed",
            "test_p124_representative_rejects_wrong_mode_stage_and_instrumentation",
            "test_p124_hard_matrix_identity_requires_same_candidate_and_cpu",
            "test_p124_failed_or_zero_work_p121_evidence_blocks_portfolio"
          ],
          "minimum_passed": 5
        },
        {
          "command": "portfolio-tests",
          "kind": "unittest",
          "synthetic": true,
          "required_names": [
            "test_p046_distinct_report_sets_are_analyzed_once_and_decision_once",
            "test_p046_hard_build_failure_overrides_speed_gain"
          ],
          "minimum_passed": 2
        }
      ],
      "outputs": {
        "matrix_test_log": "{stage}/matrix-tests.stdout",
        "portfolio_test_log": "{stage}/portfolio-tests.stdout"
      }
    }
  },
  "completion": {
    "required_phases": ["verify"],
    "outcome": "contract_only",
    "limitations": [
      "Synthetic producer validation only. P046 owns real full-family measurements, source-bound evidence, the final performance decision, and default-selection review."
    ]
  },
  "development": {
    "groups": [
      {
        "name": "statistics-unit",
        "uses": ["checker", "policy"],
        "commands": [{"name": "bootstrap-tests", "argv": ["{python}", "-B", "-m", "unittest", "tools.wtime-bench.tests.test_p124_bootstrap", "-v"]}],
        "tests": [{"command": "bootstrap-tests", "kind": "unittest", "required_names": ["test_p124_rank_distribution_matches_all_even_and_odd_resamples", "test_p124_rank_sampler_is_seeded_and_preserves_constant_medians", "test_p124_large_groups_keep_explicit_bootstrap_and_reject_bad_counts", "test_p124_primary_family_uses_equal_workload_weights"], "minimum_passed":4}],
        "outputs": {}
      },
      {
        "name": "portfolio-matrix",
        "uses": ["checker", "policy"],
        "commands": [
          {
            "name": "matrix-tests",
            "argv": [
              "{python}", "-B", "-m", "unittest",
              "tools.wtime-bench.tests.test_p124_portfolio", "-v"
            ]
          }
        ],
        "tests": [
          {
            "command": "matrix-tests",
            "kind": "unittest",
            "synthetic": true,
            "required_names": [
              "test_p124_full_four_family_two_baseline_matrix_counts_exactly",
              "test_p124_missing_family_workload_stage_run_or_pair_fails_closed",
              "test_p124_representative_rejects_wrong_mode_stage_and_instrumentation",
              "test_p124_hard_matrix_identity_requires_same_candidate_and_cpu",
              "test_p124_failed_or_zero_work_p121_evidence_blocks_portfolio"
            ],
            "minimum_passed": 5
          }
        ],
        "outputs": {
          "matrix_test_log": "{stage}/matrix-tests.stdout"
        }
      },
      {
        "name": "portfolio-orchestration",
        "uses": ["checker", "policy"],
        "commands": [
          {
            "name": "portfolio-tests",
            "argv": [
              "{python}", "-B", "-m", "unittest",
              "tools.wtime-bench.tests.test_p046_compact_gate", "-v"
            ]
          }
        ],
        "tests": [
          {
            "command": "portfolio-tests",
            "kind": "unittest",
            "synthetic": true,
            "required_names": [
              "test_p046_distinct_report_sets_are_analyzed_once_and_decision_once",
              "test_p046_hard_build_failure_overrides_speed_gain"
            ],
            "minimum_passed": 2
          }
        ],
        "outputs": {
          "portfolio_test_log": "{stage}/portfolio-tests.stdout"
        }
      }
    ]
  }
}
