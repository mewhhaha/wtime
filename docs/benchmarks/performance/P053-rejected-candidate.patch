+
+
+/// One invocation selects its accounting function. Only Compact invocations
+/// specialize; ordinary Decoded accounting and fused interior boundaries keep
+/// their existing implementation. A saved metered continuation switches the
+/// unmetered function before charging its next pending source event.
+#[cfg(feature = "compact-executor")]
+pub(super) struct SelectedBoundary {
+    next: fn(&mut Self, &mut Store, &mut Option<u64>, usize, usize, &mut Vec<Prompt>) -> Result<()>,
+}
+#[cfg(feature = "compact-executor")]
+impl SelectedBoundary {
+    pub(super) fn new(policy: ExecutionPolicy, fuel: Option<u64>) -> Self {
+        Self { next: if policy != ExecutionPolicy::Compact { legacy }
+            else if fuel.is_some() { metered } else { unmetered } }
+    }
+    #[inline]
+    pub(super) fn next_source(&mut self, store: &mut Store, fuel: &mut Option<u64>,
+        depth: usize, height: usize, prompts: &mut Vec<Prompt>) -> Result<()> {
+        (self.next)(self, store, fuel, depth, height, prompts)
+    }
+}
+#[cfg(feature = "compact-executor")]
+fn legacy(_: &mut SelectedBoundary, store: &mut Store, fuel: &mut Option<u64>,
+    depth: usize, height: usize, prompts: &mut Vec<Prompt>) -> Result<()> {
+    next_source(store, fuel, depth, height, prompts)
+}
+#[cfg(feature = "compact-executor")]
+fn merge(fuel: &mut Option<u64>, saved: Option<u64>) {
+    *fuel = match (*fuel, saved) {
+        (Some(a), Some(b)) => Some(a.min(b)),
+        (a, None) => a,
+        (None, b) => b,
+    };
+}
+#[cfg(feature = "compact-executor")]
+fn unmetered(selected: &mut SelectedBoundary, store: &mut Store, fuel: &mut Option<u64>,
+    depth: usize, height: usize, prompts: &mut Vec<Prompt>) -> Result<()> {
+    if let Some(saved) = store.resume_fuel.take() {
+        merge(fuel, saved);
+        if fuel.is_some() {
+            selected.next = metered;
+            return metered(selected, store, fuel, depth, height, prompts);
+        }
+    }
+    compact_boundary::<false>(store, fuel, depth, height, prompts)
+}
+#[cfg(feature = "compact-executor")]
+fn metered(_: &mut SelectedBoundary, store: &mut Store, fuel: &mut Option<u64>,
+    depth: usize, height: usize, prompts: &mut Vec<Prompt>) -> Result<()> {
+    if let Some(saved) = store.resume_fuel.take() { merge(fuel, saved); }
+    compact_boundary::<true>(store, fuel, depth, height, prompts)
+}
+#[cfg(feature = "compact-executor")]
+#[inline]
+fn compact_boundary<const METERED: bool>(store: &mut Store, fuel: &mut Option<u64>,
+    frame_depth: usize, operand_height: usize, prompts: &mut Vec<Prompt>) -> Result<()> {
+    if store.cancellation.is_cancelled() {
+        return Err(err(ErrorKind::ResourceLimit, "execution cancelled"));
+    }
+    crate::continuation::retire_prompts(frame_depth, prompts);
+    if METERED {
+        let n = fuel.as_mut().ok_or_else(|| trap("missing selected metered fuel"))?;
+        if *n == 0 { return Err(err(ErrorKind::ResourceLimit, "fuel exhausted")); }
+        *n -= 1;
+    }
+    store.current_fuel = *fuel;
+    if operand_height > store.engine.config.limits.max_stack_height {
+        return Err(err(ErrorKind::ResourceLimit, "operand stack limit"));
+    }
+    #[cfg(feature = "execution-reference")]
+    {
+        let index = usize::from(METERED);
+        store.compact_accounting_boundaries[index] =
+            store.compact_accounting_boundaries[index].saturating_add(1);
+    }
+    Ok(())
+}
+
+#[cfg(all(test, feature = "compact-executor", feature = "execution-reference"))]
+mod p053_tests {
+    use super::*;
+    #[test]
+    fn p053_resumed_saved_fuel_switches_to_metered_once() {
+        let engine = Engine::with_execution_policy(Config::default(), ExecutionPolicy::Compact).unwrap();
+        let mut store = Store::new(&engine);
+        let mut selected = SelectedBoundary::new(ExecutionPolicy::Compact, None);
+        let mut fuel = None;
+        let mut prompts = vec![];
+        selected.next_source(&mut store, &mut fuel, 1, 0, &mut prompts).unwrap();
+        assert_eq!(store.compact_accounting_boundaries(), [1, 0]);
+        store.resume_fuel = Some(Some(2));
+        selected.next_source(&mut store, &mut fuel, 1, 0, &mut prompts).unwrap();
+        assert_eq!(fuel, Some(1));
+        assert_eq!(store.current_fuel, Some(1));
+        assert!(store.resume_fuel.is_none());
+        selected.next_source(&mut store, &mut fuel, 1, 0, &mut prompts).unwrap();
+        assert_eq!(fuel, Some(0));
+        assert_eq!(store.compact_accounting_boundaries(), [1, 2]);
+        assert_eq!(selected.next_source(&mut store, &mut fuel, 1, 0, &mut prompts)
+            .unwrap_err().message, "fuel exhausted");
+        // A saved unlimited segment cannot erase an already active budget.
+        store.resume_fuel = Some(None);
+        assert_eq!(selected.next_source(&mut store, &mut fuel, 1, 0, &mut prompts)
+            .unwrap_err().message, "fuel exhausted");
+        assert_eq!(fuel, Some(0));
+        // Retain cancellation's priority after installing a depleted segment.
+        store.cancellation_token().cancel();
+        store.resume_fuel = Some(Some(0));
+        assert_eq!(selected.next_source(&mut store, &mut fuel, 1, 0, &mut prompts)
+            .unwrap_err().message, "execution cancelled");
+    }
+}
