@@ -0,0 +1,84 @@
+#![cfg(all(feature = "compact-executor", feature = "execution-reference"))]
+use wtime_runtime::*;
+const STORE: &[u8] = include_bytes!("../fixtures/performance/cursor/store_successor.wasm");
+fn loaded(policy: ExecutionPolicy, config: Config, bytes: &[u8]) -> (Store, Instance, Func) {
+    let engine = Engine::with_execution_policy(config, policy).unwrap();
+    let module = engine.compile(bytes).unwrap();
+    let mut store = Store::new(&engine);
+    let instance = Linker::new(&engine).instantiate(&mut store, &module).unwrap();
+    let External::Func(run) = instance.export(&store, "run").unwrap() else { panic!() };
+    (store, instance, run)
+}
+#[test]
+fn p053_scalar_results_and_source_prefixes_preserve_accounting() {
+    for policy in [ExecutionPolicy::Decoded, ExecutionPolicy::Compact, ExecutionPolicy::Reference] {
+        for budget in [None].into_iter().chain((0..=7).map(Some)) {
+            let mut config = Config::default(); config.limits.fuel = budget;
+            let (mut store, instance, run) = loaded(policy, config, STORE);
+            let result = store.invoke(run, &[]);
+            if budget.is_some_and(|n| n < 6) {
+                let error = result.unwrap_err();
+                assert_eq!(error.kind, ErrorKind::ResourceLimit);
+                assert_eq!(error.message, "fuel exhausted");
+            } else {
+                assert_eq!(result.unwrap(), RunOutcome::Returned(vec![Value::I32(7)]));
+            }
+            let External::Memory(memory) = instance.export(&store, "memory").unwrap() else { panic!() };
+            assert_eq!(store.read_memory(memory, 0, 4).unwrap(),
+                if budget.is_none_or(|n| n >= 3) { vec![7,0,0,0] } else { vec![0;4] });
+            let successful = budget.map_or(6, |n| n.min(6));
+            assert_eq!(store.compact_accounting_boundaries(),
+                if policy != ExecutionPolicy::Compact { [0,0] }
+                else if budget.is_some() { [0,successful] } else { [successful,0] });
+        }
+        for (bytes, accumulator) in [
+            (include_bytes!("../fixtures/performance/p047/accumulator.wasm").as_slice(), true),
+            (include_bytes!("../fixtures/performance/p047/dependent.wasm").as_slice(), false),
+        ] {
+            for budget in [None, Some(50_000_000)] {
+                let mut config = Config::default(); config.limits.fuel = budget;
+                let (mut store, _, run) = loaded(policy, config, bytes);
+                for n in [0i32,17,32,10000] {
+                    let expected = if accumulator { n.wrapping_mul(n-1)/2 } else {
+                        let mut value = 1i32;
+                        for _ in 0..n { value = value.wrapping_mul(1664525).wrapping_add(1013904223); }
+                        value
+                    };
+                    assert_eq!(store.invoke(run, &[Value::I32(n)]).unwrap(),
+                        RunOutcome::Returned(vec![Value::I32(expected)]));
+                    let counts = store.compact_accounting_boundaries();
+                    if policy == ExecutionPolicy::Compact {
+                        assert!(store.compact_dispatches() > 0);
+                        assert!(counts[usize::from(budget.is_some())] > 0);
+                        assert_eq!(counts[usize::from(budget.is_none())], 0);
+                    } else { assert_eq!(counts, [0,0]); }
+                }
+            }
+        }
+    }
+}
+#[test]
+fn p053_unmetered_cancellation_and_operand_limits_still_apply() {
+    for policy in [ExecutionPolicy::Decoded, ExecutionPolicy::Compact, ExecutionPolicy::Reference] {
+        let mut config = Config::default(); config.limits.max_stack_height = 2;
+        let (mut store, _, run) = loaded(policy, config,
+            include_bytes!("../fixtures/performance/accounting/transient_stack.wasm"));
+        assert_eq!(store.invoke(run, &[]).unwrap_err().message, "operand stack limit");
+        if policy == ExecutionPolicy::Compact { assert!(store.compact_accounting_boundaries()[0] > 0); }
+        let engine = Engine::with_execution_policy(Config::default(), policy).unwrap();
+        let module = engine.compile(include_bytes!("../fixtures/performance/accounting/host_then_store.wasm")).unwrap();
+        let mut store = Store::new(&engine);
+        let cancel = store.cancellation_token();
+        let stop = store.create_host_func(FuncType::new(vec![], vec![]), move |_| {
+            cancel.cancel(); Ok(vec![])
+        }).unwrap();
+        let mut linker = Linker::new(&engine);
+        linker.define("host", "stop", External::Func(stop)).unwrap();
+        let instance = linker.instantiate(&mut store, &module).unwrap();
+        let External::Func(run) = instance.export(&store, "run").unwrap() else { panic!() };
+        assert_eq!(store.invoke(run, &[]).unwrap_err().message, "execution cancelled");
+        let External::Memory(memory) = instance.export(&store, "memory").unwrap() else { panic!() };
+        assert_eq!(store.read_memory(memory, 0, 4).unwrap(), [0;4]);
+        if policy == ExecutionPolicy::Compact { assert!(store.compact_accounting_boundaries()[0] > 0); }
+    }
+}
