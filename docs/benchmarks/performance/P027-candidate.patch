+#[cfg(test)]
+mod performance_bulk_cancellation {
+    use super::*;
+    #[test]
+    fn p027_copy_cancellation_commits_backward_chunk_only() {
+        let engine = Engine::new(Config::default()).unwrap();
+        let module = engine
+            .compile(include_bytes!(
+                "../tests/fixtures/performance/p027/cancel_prefix.wasm"
+            ))
+            .unwrap();
+        let mut store = Store::new(&engine);
+        let instance = Linker::new(&engine)
+            .instantiate(&mut store, &module)
+            .unwrap();
+        let External::Memory(memory) = instance.export(&store, "memory").unwrap() else {
+            panic!()
+        };
+        let External::Func(run) = instance.export(&store, "run").unwrap() else {
+            panic!()
+        };
+        let original: Vec<u8> = (0..262144usize)
+            .map(|i| (i * 29 + 7 + (i >> 16) * 53) as u8)
+            .collect();
+        store.write_memory(memory, 0, &original).unwrap();
+        store.bulk_cancel_after = Some(65536);
+        let error = store.invoke(run, &[]).unwrap_err();
+        assert_eq!(error.kind, ErrorKind::ResourceLimit);
+        assert!(error.message.contains("cancel"));
+        let mut expected = original.clone();
+        // dst > src selects backward chunks even for disjoint ranges.
+        expected[196608..262144].copy_from_slice(&original[65536..131072]);
+        assert_eq!(store.read_memory(memory, 0, 262144).unwrap(), expected);
+        assert!(store.active_roots.is_empty());
+        store.cancellation_token().reset();
+        store.invoke(run, &[]).unwrap();
+        expected[131072..262144].copy_from_slice(&original[..131072]);
+        assert_eq!(store.read_memory(memory, 0, 262144).unwrap(), expected);
+    }
+}
