          "name": "python",
          "argv": [
            "{python}",
            "-B",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tools/verification/tests",
            "-p",
            "test_p145.py",
            "-v",
            "-b"
          ]
        },
        {
          "name": "rust",
          "argv": [
            "cargo",
            "test",
            "--locked",
            "--offline",
            "-j",
            "1",
            "--manifest-path",
            "tools/wtime-path-probe/Cargo.toml",
            "--",
            "--show-output"
          ]
        },
        {
          "name": "build",
          "argv": [
            "cargo",
            "build",
            "--locked",
            "--offline",
            "-j",
            "1",
            "--release",
            "--manifest-path",
            "tools/wtime-path-probe/Cargo.toml"
          ]
        },
        {
          "name": "runtime-controls",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/verification/producers/p067_workflow.py",
            "verify-prior",
            "--output",
            "{stage}/prior-controls.json"
          ]
        },
        {
          "name": "collect",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/verification/producers/p145.py",
            "collect",
            "--freeze",
            "{freeze_dir}/freeze.json",
            "--binary",
            "{repo}/tools/wtime-path-probe/target/release/wtime-path-probe",
            "--output",
            "{stage}/diagnostics"
          ]
        }
      ],
      "tests": [
        {
          "command": "python",
          "kind": "unittest",
          "required_names": [
            "test_adaptive_uses_threshold_plus_one_invocations",
            "test_case_validation_binds_profile_arguments_and_fixture_hashes",
            "test_case_validation_rejects_missing_duplicate_and_unknown_ids",
            "test_compile_only_requires_zero_invocations",
            "test_eager_classifies_all_four_execution_paths",
            "test_wire_rejects_dirty_cleanup_and_stale_activation_capacity",
            "test_wire_rejects_oracle_mismatch_booleans_and_u64_overflow",
            "test_wire_requires_exact_schema_strategy_and_typed_fields"
          ],
          "minimum_passed": 8
        },
        {
          "command": "rust",
          "kind": "cargo",
          "features": [],
          "minimum_passed": 3,
          "unfiltered": true,
          "required_names": [
            "typed_values_preserve_float_bits_and_signed_integer_boundaries",
            "malformed_values_and_unknown_feature_bits_fail_closed",
            "invalid_strategy_and_repetition_fail_before_file_io"
          ]
        }
      ],
      "outputs": {
        "prior": "{stage}/prior-controls.json",
        "observations": "{stage}/diagnostics/report.json",
        "records": "{stage}/diagnostics/records.json",
        "artifacts": "{stage}/diagnostics/artifacts.json",
        "binary": "{stage}/diagnostics/wtime-path-probe"
      },
      "checks": [
        {
          "artifact": "observations",
          "pointer": "/status",
          "op": "equal",
          "value": "passed"
        },
        {
          "artifact": "observations",
          "pointer": "/timing_evidence",
          "op": "equal",
          "value": false
        }
      ]
    },
    "analyze": {
      "uses": [
        "runtime_sources",
        "tool",
        "harness",
        "producer",
        "selection"
      ],
      "dependencies": [
        "freeze",
        "verify"
      ],
      "commands": [
        {
          "name": "summarize",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/verification/producers/p145.py",
            "summarize",
            "--freeze",
            "{freeze_dir}/freeze.json",
            "--report",
            "{verify_dir}/diagnostics/report.json",
            "--output",
            "{stage}/proof.json"
          ]
        }
      ],
      "outputs": {
        "proof": "{stage}/proof.json"
      },
      "checks": [
        {
          "artifact": "proof",
          "pointer": "/status",
          "op": "equal",
          "value": "passed"
        },
        {
          "artifact": "proof",
          "pointer": "/timing_evidence",
          "op": "equal",
          "value": false
        }
      ]
    }
  },
