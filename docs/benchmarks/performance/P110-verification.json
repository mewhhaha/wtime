{
  "schema_version": 1,
  "task": "P110",
  "identities": {
    "runtime_sources": {
      "paths": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "crates/*/Cargo.toml",
        "crates/**/*.rs"
      ]
    },
    "tool": {
      "paths": [
        "tools/wtime-footprint/Cargo.toml",
        "tools/wtime-footprint/Cargo.lock",
        "tools/wtime-footprint/src/**/*.rs"
      ]
    },
    "producer": {
      "paths": [
        "tools/verification/producers/p110.py",
        "tools/verification/producers/p109.py",
        "tools/verification/*.py",
        "tools/verify.py"
      ]
    },
    "fixtures": {
      "paths": [
        "tools/wtime-bench/fixtures/call_overhead.*",
        "tools/wtime-bench/fixtures/prepare_large.*",
        "tools/wtime-bench/fixtures/representative/graph_bfs.*"
      ]
    },
    "tests": {
      "paths": [
        "tools/wtime-bench/tests/test_p110_final_budgets.py"
      ]
    },
    "final_review": {
      "paths": [
        "tools/verification/producers/p110_finalize.py",
        "tools/verification/producers/p110_builds.py",
        "tools/checks/build_budget.py",
        "tools/checks/dependency_budget.py",
        "tools/verification/producers/p108.py",
        "tools/verification/producers/p109.py",
        "tools/verification/producers/p110.py",
        "tools/wtime-bench/tests/test_p110_cold_reviews.py"
      ]
    },
    "build_review_tests": {
      "paths": ["tools/wtime-bench/tests/test_p110_builds.py"]
    },
    "build_inputs": {
      "paths": ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "crates/**/*", "tools/wtime-conformance/**/*"]
    },
    "cold_collection": {
      "paths": [
        "tools/verification/producers/p110_cold.py",
        "target/performance/P080-isolated-source/**",
        "target/performance/P067-builds/**",
        "target/performance/P067-before/manifest.json",
        "target/performance/P067-before/source/**",
        "target/performance/baseline/manifest.json",
        "target/performance/baseline/binary/**"
      ]
    }
  },
  "stages": {
    "freeze": {
      "uses": [
        "runtime_sources",
        "tool",
        "producer",
        "fixtures"
      ],
      "commands": [
        {
          "name": "freeze",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/verification/producers/p110.py",
            "freeze",
            "--output",
            "{stage}/freeze.json"
          ]
        }
      ],
      "outputs": {
        "freeze": "{stage}/freeze.json"
      },
      "checks": [
        {
          "artifact": "freeze",
          "pointer": "/status",
          "op": "equal",
          "value": "passed"
        }
      ]
    },
    "verify": {
      "uses": [
        "runtime_sources",
        "tool",
        "producer",
        "fixtures",
        "tests"
      ],
      "dependencies": [
        "freeze"
      ],
      "commands": [
        {
          "name": "footprint-tests",
          "argv": [
            "{python}",
            "-B",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tools/wtime-bench/tests",
            "-p",
            "test_p110_final_budgets.py",
            "-v",
            "-b"
          ]
        },
        {
          "name": "build-footprint-tool",
          "argv": [
            "cargo",
            "build",
            "--locked",
            "--offline",
            "--release",
            "-j",
            "1",
            "--manifest-path",
            "tools/wtime-footprint/Cargo.toml"
          ]
        },
        {
          "name": "footprints",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/verification/producers/p110.py",
            "footprints",
            "--binary",
            "{repo}/tools/wtime-footprint/target/release/wtime-footprint-inspect",
            "--output",
            "{stage}/footprints"
          ]
        }
      ],
      "tests": [
        {
          "command": "footprint-tests",
          "kind": "unittest",
          "minimum_passed": 5,
          "required_names": [
            "test_accepts_all_modes_for_small_large_and_representative_source_lengths",
            "test_adaptive_compile_only_cache_must_be_empty_and_within_byte_limits",
            "test_adaptive_unavailable_cache_is_explicit_and_never_fabricates_a_snapshot",
            "test_compact_counters_are_owned_by_compact_mode_only",
            "test_counters_are_nonnegative_typed_and_source_lengths_exact_without_guest_runs"
          ]
        }
      ],
      "outputs": {
        "footprints": "{stage}/footprints/report.json",
        "binary": "{stage}/footprints/wtime-footprint-inspect"
      },
      "checks": [
        {
          "artifact": "footprints",
          "pointer": "/status",
          "op": "equal",
          "value": "passed"
        }
      ]
    },
    "measure": {
      "uses": ["runtime_sources", "cold_collection", "fixtures"],
      "dependencies": ["freeze", "verify"],
      "commands": [{
        "name": "cold-comparisons",
        "argv": ["{python}", "-B", "{repo}/tools/verification/producers/p110_cold.py", "--output", "{stage}/cold"]
      }],
      "outputs": {"cold": "{stage}/cold/report.json", "artifacts": "{stage}/cold/artifacts.json"},
      "checks": [{"artifact": "cold", "pointer": "/status", "op": "equal", "value": "passed"}]
    }
  },
  "source_delta": {
    "identity": "runtime_sources",
    "baseline": "{freeze_dir}/freeze.json",
    "pointer": "/core_sources",
    "allowed_changes": [],
    "allowed_additions": []
  },
  "development": {
    "groups": [
      {
        "name": "build-review-tests",
        "uses": ["final_review", "build_review_tests", "producer"],
        "commands": [{"name": "build-review-tests", "argv": ["{python}", "-B", "-m", "unittest", "discover", "-s", "tools/wtime-bench/tests", "-p", "test_p110_builds.py", "-v", "-b"]}],
        "tests": [{"command": "build-review-tests", "kind": "unittest", "minimum_passed": 6,
          "required_names": ["test_accepts_source_current_default_and_optional_reports", "test_optional_ratios_are_review_only_and_never_create_a_speedup_claim", "test_rejects_stale_current_or_post_build_source_maps_and_hashes", "test_rejects_mixed_toolchains_jobs_and_wrong_optional_features", "test_rejects_failed_build_stages_hard_budget_and_unrestored_leaf", "test_requires_the_existing_zero_violation_dependency_report"]}]
      },
      {
        "name": "cold-review-tests",
        "uses": ["final_review", "producer"],
        "commands": [{"name": "cold-review-tests", "argv": ["{python}", "-B", "-m", "unittest", "discover", "-s", "tools/wtime-bench/tests", "-p", "test_p110_cold_reviews.py", "-v", "-b"]}],
        "tests": [{"command": "cold-review-tests", "kind": "unittest", "minimum_passed": 4,
          "required_names": ["test_complete_cold_groups_keep_two_runs_and_additional_memory_cost", "test_over_budget_and_uncertain_intervals_remain_visible", "test_missing_duplicate_short_or_same_seed_groups_are_rejected", "test_boolean_counts_nan_and_invalid_confidence_intervals_fail"]}]
      },
      {
        "name": "footprint-tests",
        "uses": [
          "runtime_sources",
          "producer",
          "tests"
        ],
        "commands": [
          {
            "name": "footprint-tests",
            "argv": [
              "{python}",
              "-B",
              "-m",
              "unittest",
              "discover",
              "-s",
              "tools/wtime-bench/tests",
              "-p",
              "test_p110_final_budgets.py",
              "-v",
              "-b"
            ]
          }
        ],
        "tests": [
          {
            "command": "footprint-tests",
            "kind": "unittest",
            "minimum_passed": 5,
            "required_names": [
              "test_accepts_all_modes_for_small_large_and_representative_source_lengths",
              "test_adaptive_compile_only_cache_must_be_empty_and_within_byte_limits",
              "test_adaptive_unavailable_cache_is_explicit_and_never_fabricates_a_snapshot",
              "test_compact_counters_are_owned_by_compact_mode_only",
              "test_counters_are_nonnegative_typed_and_source_lengths_exact_without_guest_runs"
            ]
          }
        ]
      }
    ]
  },
  "completion": {
    "required_phases": [
      "freeze",
      "verify",
      "measure",
      "analyze"
    ],
    "outcome": "contract_only",
    "limitations": [
      "Footprint preparation only until final portfolio timing and budget analysis phases are supplied."
    ]
  }
}
