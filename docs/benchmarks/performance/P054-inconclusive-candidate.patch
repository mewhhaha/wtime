+#![cfg(all(feature = "compact-executor", feature = "execution-reference"))]
+use wtime_runtime::*;
+const REGIONS: &[u8] = include_bytes!("../fixtures/performance/p054/regions.wasm");
+const POLICIES: [ExecutionPolicy; 3] = [ExecutionPolicy::Decoded, ExecutionPolicy::Reference, ExecutionPolicy::Compact];
+fn loaded(policy: ExecutionPolicy, config: Config, bytes: &[u8], name: &str) -> (Store, Func) {
+    let engine = Engine::with_execution_policy(config, policy).unwrap();
+    let module = engine.compile(bytes).unwrap();
+    let mut store = Store::new(&engine);
+    let instance = Linker::new(&engine).instantiate(&mut store, &module).unwrap();
+    let External::Func(function) = instance.export(&store, name).unwrap() else { panic!() };
+    (store, function)
+}
+fn view(result: Result<RunOutcome>) -> std::result::Result<RunOutcome, (ErrorKind, String)> {
+    result.map_err(|error| (error.kind, error.message))
+}
+fn regions() -> [(&'static str, Vec<Value>, i32, Vec<Vec<i32>>); 5] {
+    [
+        ("0wrap", vec![], i32::MIN, vec![vec![],vec![i32::MAX],vec![i32::MAX,1],vec![i32::MIN]]),
+        ("1and", vec![], 324508639, vec![vec![],vec![324508639],vec![324508639,-1],vec![324508639]]),
+        ("2or", vec![], -2147483641, vec![vec![],vec![i32::MIN],vec![i32::MIN,7],vec![-2147483641]]),
+        ("3xor", vec![], -324508640, vec![vec![],vec![-1],vec![-1,324508639],vec![-324508640]]),
+        ("4copy", vec![Value::I32(-37)], -37, vec![vec![],vec![-37],vec![],vec![-37]]),
+    ]
+}
+
+#[test]
+fn p054_literal_and_identity_results_use_verified_fusions() {
+    for policy in POLICIES {
+        for (name, args, expected, _) in regions() {
+            let (mut store, run) = loaded(policy, Config::default(), REGIONS, name);
+            assert_eq!(store.invoke(run, &args).unwrap(), RunOutcome::Returned(vec![Value::I32(expected)]));
+            assert_eq!(store.compact_fused_groups(), u64::from(policy == ExecutionPolicy::Compact));
+            assert_eq!(store.compact_dispatches(), if policy == ExecutionPolicy::Compact { 4 } else { 0 });
+        }
+        let (mut store, copy) = loaded(policy, Config::default(), REGIONS, "4copy");
+        for input in [i32::MIN,i32::MAX,-1,0,1,0x2468ace] {
+            let before = store.compact_fused_groups();
+            assert_eq!(store.invoke(copy, &[Value::I32(input)]).unwrap(), RunOutcome::Returned(vec![Value::I32(input)]));
+            assert_eq!(store.compact_fused_groups()-before, u64::from(policy == ExecutionPolicy::Compact));
+        }
+        let (mut store, div) = loaded(policy, Config::default(), REGIONS, "5div");
+        let error = store.invoke(div, &[]).unwrap_err();
+        assert_eq!(error.kind, ErrorKind::Trap);
+        assert!(error.message.contains("divide by zero"), "{}",error.message);
+        assert_eq!(store.compact_fused_groups(), 0);
+        let (mut store, float) = loaded(policy, Config::default(), REGIONS, "6float");
+        assert_eq!(store.invoke(float, &[]).unwrap(), RunOutcome::Returned(vec![Value::F32(3.0f32.to_bits())]));
+        assert_eq!(store.compact_fused_groups(), 0);
+        for (bytes, shape) in [
+            (include_bytes!("../../../../tools/verification/tests/data/admitted_wasm/p128_identity_copy.wasm").as_slice(), 0),
+            (include_bytes!("../../../../tools/verification/tests/data/admitted_wasm/p128_literal_wrap_add.wasm").as_slice(), 1),
+            (include_bytes!("../../../../tools/verification/tests/data/admitted_wasm/p128_literal_bitwise.wasm").as_slice(), 2),
+        ] {
+            for n in [0i32,1,17,32,1024,10000] {
+                let events = 9+14*n as u64;
+                let expected = match shape { 0 => n, 1 => i32::MIN.wrapping_mul(n),
+                    2 => 324508639i32.wrapping_mul(n), _ => unreachable!() };
+                for fuel in [None,Some(events),Some(events-1)] {
+                    let mut config = Config::default(); config.limits.fuel = fuel;
+                    let (mut store, run) = loaded(policy, config, bytes, "run");
+                    let result = view(store.invoke(run, &[Value::I32(n)]));
+                    assert_eq!(result, if fuel == Some(events-1) {
+                        Err((ErrorKind::ResourceLimit,"fuel exhausted".into()))
+                    } else { Ok(RunOutcome::Returned(vec![Value::I32(expected)])) });
+                    assert_eq!(store.compact_fused_groups(), if policy == ExecutionPolicy::Compact { n as u64 } else { 0 });
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn p054_every_source_prefix_and_materialization_matches_decoded() {
+    for (name, args, expected, states) in regions() {
+        for fuel in 0..=5 {
+            for policy in POLICIES {
+                let mut config = Config::default(); config.limits.fuel = Some(fuel);
+                let (mut store, run) = loaded(policy, config, REGIONS, name);
+                assert_eq!(view(store.invoke(run,&args)), if fuel < 4 {
+                    Err((ErrorKind::ResourceLimit,"fuel exhausted".into()))
+                } else { Ok(RunOutcome::Returned(vec![Value::I32(expected)])) });
+                assert_eq!(store.compact_dispatches(), if policy == ExecutionPolicy::Compact { fuel.min(4) } else { 0 });
+                let fused_len = if name == "4copy" { 2 } else { 3 };
+                assert_eq!(store.compact_fused_groups(), u64::from(policy == ExecutionPolicy::Compact && fuel >= fused_len));
+            }
+        }
+        for fuel in [None,Some(4)] {
+            for (pc, state) in states.iter().enumerate() {
+                let mut snapshots = vec![];
+                for policy in [ExecutionPolicy::Decoded,ExecutionPolicy::Compact] {
+                    let mut config = Config::default(); config.limits.fuel = fuel;
+                    let (mut store, run) = loaded(policy, config, REGIONS, name);
+                    store.request_materialization_roundtrip(run,pc).unwrap();
+                    assert_eq!(store.invoke(run,&args).unwrap(),RunOutcome::Returned(vec![Value::I32(expected)]));
+                    let snapshot = store.execution_snapshot().unwrap().clone();
+                    assert_eq!(snapshot.cursor.source_pc, pc);
+                    assert_eq!(snapshot.operands,state.iter().map(|v|DiagnosticValue::I32(*v)).collect::<Vec<_>>());
+                    assert_eq!(snapshot.frames[0].locals,if name == "4copy" { vec![DiagnosticValue::I32(-37)] } else { vec![] });
+                    assert_eq!(snapshot.remaining_fuel,fuel.map(|_|3-pc as u64));
+                    assert!(snapshot.pending_boundary_charged && !snapshot.truncated);
+                    assert_eq!(store.materialization_roundtrips(),1);
+                    let fused_len = if name == "4copy" { 2 } else { 3 };
+                    if pc > 0 && pc < fused_len { assert_eq!(store.compact_fused_groups(),0); }
+                    snapshots.push(snapshot);
+                }
+                assert_eq!(snapshots[0],snapshots[1],"{name} boundary {pc}, fuel {fuel:?}");
+            }
+        }
+
+    }
+}
