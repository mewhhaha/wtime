        "tools/wtime-bench/fixtures/memory/**",
        "tools/wtime-bench/fixtures/simd/**",
        "tools/wtime-bench/fixtures/representative/**"
      ]
    },
    "producer_and_tests": {
      "paths": [
        "tools/verification/producers/p123.py",
        "tools/wtime-bench/tests/test_p123*.py"
      ]
    }
  },
  "stages": {
    "verify": {
      "uses": [
        "frozen_baseline",
        "adapter_and_routes",
        "producer_and_tests"
      ],
      "commands": [
        {
          "name": "build-typed-adapter",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/wtime-bench/p123_adapter.py",
            "build",
            "--baseline",
            "{repo}/target/performance/baseline",
            "--output",
            "{repo}/target/performance/P123-p001-adapter"
          ]
        },
        {
          "name": "typed-capability-probes",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/verification/producers/p123.py",
            "--adapter",
            "{repo}/target/performance/P123-p001-adapter",
            "--output",
            "{stage}/probes"
          ]
        },
        {
          "name": "typed-adapter-tests",
          "argv": [
            "{python}",
            "-B",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tools/wtime-bench/tests",
            "-p",
            "test_p123*.py",
            "-v"
          ]
        }
      ],
      "tests": [
        {
          "command": "typed-adapter-tests",
          "kind": "unittest",
          "required_names": [
            "test_p123_adapter_is_hash_bound_to_immutable_p001",
            "test_p123_typed_scalar_and_memory_routes_preserve_oracles",
            "test_p123_simd_representative_capabilities_are_actual",
            "test_p123_rejects_mutated_archive_and_false_capabilities",
            "test_p123_adapter_rejects_substituted_core_and_stale_harness"
          ],
          "minimum_passed": 5
        }
      ],
      "outputs": {
        "report": "{stage}/probes/report.json",
        "artifacts": "{stage}/probes/artifacts.tar.gz",
        "inventory": "{stage}/probes/inventory.json",
        "binary": "{stage}/probes/wtime-bench",
        "adapter": "{stage}/probes/adapter-manifest.json",
        "commands": "{stage}/probes/commands.jsonl"
      },
      "checks": [
