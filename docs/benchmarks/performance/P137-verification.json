        "target/performance/P136/shared-finalization/attempt-0001/evidence.json",
        "target/verification/runs/P136/verify/attempt-0001/proof/report.json",
        "target/verification/runs/P136/verify/attempt-0001/proof/collection/report.json",
        "target/verification/runs/P136/verify/attempt-0001/proof/collection/checkpoint.jsonl",
        "target/verification/runs/P136/verify/attempt-0001/proof/collection/commands/**/*",
        "target/verification/runs/P136/verify/attempt-0001/proof/collection/helpers/**/*",
