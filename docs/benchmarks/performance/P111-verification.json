      "uses": [
        "runtime_sources",
        "producer"
      ],
      "commands": [
        {
          "name": "freeze",
          "argv": [
            "{python}",
            "-B",
            "{repo}/tools/verification/producers/p111.py",
            "freeze",
            "--output",
            "{stage}/freeze.json"
          ]
        }
      ],
      "outputs": {
        "freeze": "{stage}/freeze.json"
      },
      "checks": [
        {
          "artifact": "freeze",
          "pointer": "/status",
          "op": "equal",
          "value": "passed"
        }
      ]
    },
