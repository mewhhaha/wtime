+    /// Actual optional local-type location storage, shared across Module clones.
+    pub fn gc_layout_bytes(&self) -> usize {
+        self.data
+            .gc_layouts
+            .as_ref()
+            .map_or(0, |p| p.retained_bytes())
+    }
+    fn gc_type_definition(&self, n: usize) -> Result<&SubType> {
+        let groups = &self.data.inner.decoded().type_groups;
+        let found = if let Some(layouts) = &self.data.gc_layouts {
+            layouts.get(groups, n)
+        } else {
+            groups.iter().flat_map(|g| &g.types).nth(n)
+        };
+        found.ok_or_else(|| trap("GC type out of bounds"))
+    }
     pub fn source_bytes(&self) -> usize {
         self.data.inner.decoded().bytes.len()
     }
