+// Parent-staged private tests only. Unbuilt/unexecuted; integrate into gc_layout.rs
+// after copying the staged CC0 fixtures to the recorded relative paths.
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const HIGH: &[u8] =
+        include_bytes!("../tests/fixtures/performance/gc/packed_gc_types_1024.wasm");
+    const FALLBACK: &[u8] =
+        include_bytes!("../tests/fixtures/performance/gc/packed_gc_types_256.wasm");
+    fn engine() -> Engine {
+        Engine::new(Config {
+            features: FeatureSet::all_phase3_core(),
+            ..Config::default()
+        })
+        .unwrap()
+    }
+    fn invoke(store: &mut Store, instance: Instance, name: &str) {
+        let External::Func(f) = instance.export(store, name).unwrap() else {
+            panic!()
+        };
+        assert_eq!(
+            store.invoke(f, &[Value::I32(17)]).unwrap(),
+            RunOutcome::Returned(vec![Value::I32(4335)])
+        );
+    }
+    #[test]
+    fn p034_local_indices_remain_distinct_from_canonical_identity() {
+        let e = engine();
+        for (label, bytes) in [
+            (
+                16,
+                include_bytes!("../tests/fixtures/performance/gc/packed_gc_types_16.wasm")
+                    .as_slice(),
+            ),
+            (256, FALLBACK),
+            (1024, HIGH),
+        ] {
+            let observed = e.compile(bytes).unwrap();
+            let clone = observed.clone();
+            assert!(Arc::ptr_eq(&observed.data, &clone.data));
+            assert_eq!(observed.gc_layout_bytes(), clone.gc_layout_bytes());
+            println!(
+                "P034_METADATA types={label} retained_bytes={} clone_shared=true",
+                observed.gc_layout_bytes()
+            );
+        }
+        let module = e.compile(HIGH).unwrap();
+        assert!(module.gc_layout_bytes() > 0 && module.gc_layout_bytes() <= 1 << 20);
+        assert_eq!(module.data.canonical[0], module.data.canonical[1023]);
+        assert_ne!(module.data.canonical[0], module.data.canonical[1024]);
+        let local = module.gc_type_definition(1024).unwrap();
+        assert!(matches!(local.composite, CompositeType::Array(_)));
+        let original = module
+            .data
+            .inner
+            .decoded()
+            .type_groups
+            .iter()
+            .flat_map(|g| &g.types)
+            .nth(1024)
+            .unwrap();
+        assert!(std::ptr::eq(local, original));
+        let shared = module.clone();
+        assert!(Arc::ptr_eq(&module.data, &shared.data));
+        let mut store = Store::new(&e);
+        let i = Linker::new(&e).instantiate(&mut store, &module).unwrap();
+        drop(module);
+        drop(shared);
+        invoke(&mut store, i, "run");
+        assert_eq!(store.collect().unwrap().reclaimed, 1);
+    }
+    #[test]
+    fn p034_bounded_failure_uses_complete_borrowed_fallback() {
+        let e = engine();
+        let mut module = e.compile(FALLBACK).unwrap();
+        let groups = &module.data.inner.decoded().type_groups;
+        assert!(GcLayouts::prepare(groups, 0, 100_000).is_none());
+        assert!(GcLayouts::prepare(groups, 1 << 20, 0).is_none());
+        assert!(GcLayouts::prepare(groups, 8, 100_000).is_none());
+        let ids = module.data.canonical.clone();
+        Arc::get_mut(&mut module.data).unwrap().gc_layouts = None;
+        assert_eq!(module.data.canonical, ids);
+        assert_eq!(module.gc_layout_bytes(), 0);
+        assert!(matches!(
+            module.gc_type_definition(256).unwrap().composite,
+            CompositeType::Array(_)
+        ));
+        assert!(matches!(
+            module.gc_type_definition(257).unwrap().composite,
+            CompositeType::Struct(_)
+        ));
+        assert_eq!(
+            module.gc_type_definition(usize::MAX).unwrap_err().message,
+            "GC type out of bounds"
+        );
+        let mut store = Store::new(&e);
+        let i = Linker::new(&e).instantiate(&mut store, &module).unwrap();
+        drop(module);
+        invoke(&mut store, i, "run");
+        invoke(&mut store, i, "run_struct");
+        assert_eq!(store.collect().unwrap().reclaimed, 2);
+    }
+    #[test]
+    fn p034_reservation_failure_declines_before_publishing_locations() {
+        let e = engine();
+        let mut module = e.compile(FALLBACK).unwrap();
+        let groups = &module.data.inner.decoded().type_groups;
+        let mut requested = None;
+        let declined =
+            GcLayouts::prepare_with_reserve(groups, 1 << 20, 100_000, |locations, count| {
+                assert!(locations.is_empty());
+                assert_eq!(locations.capacity(), 0);
+                requested = Some(count);
+                None
+            });
+        assert!(declined.is_none());
+        assert_eq!(requested, Some(groups.iter().map(|g| g.types.len()).sum()));
+        Arc::get_mut(&mut module.data).unwrap().gc_layouts = declined;
+        let mut store = Store::new(&e);
+        let instance = Linker::new(&e).instantiate(&mut store, &module).unwrap();
+        invoke(&mut store, instance, "run");
+        invoke(&mut store, instance, "run_struct");
+        assert_eq!(store.collect().unwrap().reclaimed, 2);
+    }
+    #[test]
+    fn p034_mvp_modules_do_not_allocate_optional_gc_locations() {
+        let groups = [TypeGroup {
+            explicit: false,
+            types: vec![SubType::final_type(
+                CompositeType::Func(FuncType::default()),
+            )],
+        }];
+        assert!(GcLayouts::prepare(&groups, 1 << 20, 100_000).is_none());
+        let module = engine().compile(b"\0asm\x01\0\0\0").unwrap();
+        assert_eq!(module.gc_layout_bytes(), 0);
+        assert_eq!(
+            module.gc_type_definition(0).unwrap_err().message,
+            "GC type out of bounds"
+        );
+    }
+}
