+//! Bounded optional local-type locations; no canonical IDs or guest handles.
+use super::*;
+#[derive(Clone, Copy, Debug)]
+struct Location {
+    group: u32,
+    member: u32,
+}
+#[derive(Debug)]
+pub(super) struct GcLayouts {
+    locations: Vec<Location>,
+}
+impl GcLayouts {
+    pub(super) fn prepare(
+        groups: &[TypeGroup],
+        byte_limit: usize,
+        work_limit: usize,
+    ) -> Option<Self> {
+        Self::prepare_with_reserve(groups, byte_limit, work_limit, |locations, count| {
+            locations.try_reserve_exact(count).ok()
+        })
+    }
+    fn prepare_with_reserve<R>(
+        groups: &[TypeGroup],
+        byte_limit: usize,
+        work_limit: usize,
+        reserve: R,
+    ) -> Option<Self>
+    where
+        R: FnOnce(&mut Vec<Location>, usize) -> Option<()>,
+    {
+        let mut count = 0usize;
+        let mut work = 0usize;
+        let mut has_gc = false;
+        for group in groups {
+            count = count.checked_add(group.types.len())?;
+            // Two bounded traversals, including empty recursive groups.
+            work = work.checked_add(group.types.len().checked_add(1)?.checked_mul(2)?)?;
+            if work > work_limit {
+                return None;
+            }
+            has_gc |= group.types.iter().any(|t| {
+                matches!(
+                    t.composite,
+                    CompositeType::Struct(_) | CompositeType::Array(_)
+                )
+            });
+        }
+        if !has_gc
+            || count
+                .checked_mul(std::mem::size_of::<Location>())?
+                .checked_add(std::mem::size_of::<Self>())?
+                > byte_limit
+        {
+            return None;
+        }
+        let mut locations = Vec::new();
+        reserve(&mut locations, count)?;
+        if locations
+            .capacity()
+            .checked_mul(std::mem::size_of::<Location>())?
+            .checked_add(std::mem::size_of::<Self>())?
+            > byte_limit
+        {
+            return None;
+        }
+        for (g, group) in groups.iter().enumerate() {
+            let group_index = u32::try_from(g).ok()?;
+            for m in 0..group.types.len() {
+                locations.push(Location {
+                    group: group_index,
+                    member: u32::try_from(m).ok()?,
+                });
+            }
+        }
+        Some(Self { locations })
+    }
+    pub(super) fn retained_bytes(&self) -> usize {
+        std::mem::size_of::<Self>() + self.locations.capacity() * std::mem::size_of::<Location>()
+    }
+    pub(super) fn get<'a>(&self, groups: &'a [TypeGroup], n: usize) -> Option<&'a SubType> {
+        let p = self.locations.get(n)?;
+        groups.get(p.group as usize)?.types.get(p.member as usize)
+    }
+}
