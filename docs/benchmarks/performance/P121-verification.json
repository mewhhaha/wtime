            "compact-executor",
            "performance-counters"
          ],
          "required_names": [
            "p121_compact_counts_are_per_module_and_checked",
            "p121_worker_snapshots_merge_once_with_checked_arithmetic",
            "p121_fallback_is_derived_without_double_count_and_hidden_failures_fail",
            "p121_repeated_runs_on_one_adapter_merge_only_new_deltas"
          ],
          "minimum_passed": 4
