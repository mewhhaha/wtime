          "required_names": [
            "test_four_cli_reports_validate_with_real_profile_and_hash_inputs",
            "test_wrong_counts_and_hidden_failures_are_rejected",
            "test_zero_compact_work_and_foreign_mode_are_rejected",
            "test_locked_membership_and_preparation_unknowns_are_strict",
            "test_four_command_coverage_and_unsigned_bounds_are_enforced"
          ],
          "minimum_passed": 5
