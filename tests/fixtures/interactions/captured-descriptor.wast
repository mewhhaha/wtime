;; T163: the embedding replaces env.collect with a forced collector.
(module $env (func (export "collect")))
(register "env")
(module
  (import "env" "collect" (func $collect))
  (rec
    (type $object (descriptor $descriptor) (struct (field i32)))
    (type $descriptor (describes $object) (struct (field i32))))
  (type $f (func (result i32)))
  (type $c (cont $f))
  (type $rf (func (param i32) (result i32)))
  (type $rc (cont $rf))
  (tag $yield (result i32))
  (tag $error (param (ref $object)))
  (func $worker (type $f) (local $obj (ref null $object))
    (local.set $obj (struct.new_desc $object (i32.const 77)
      (struct.new $descriptor (i32.const 9))))
    (block $caught (result (ref $object))
      (try_table (result (ref $object)) (catch $error $caught)
        (drop (suspend $yield))
        (throw $error (ref.as_non_null (local.get $obj)))))
    (struct.get $object 0))
  (elem declare func $worker)
  (func (export "run") (result i32) (local $k (ref null $rc))
    (block $paused (result (ref $rc))
      (resume $c (on $yield $paused) (cont.new $c (ref.func $worker)))
      (return))
    (local.set $k)
    (call $collect)
    (resume $rc (i32.const 42) (local.get $k)))
  (func (export "null-descriptor")
    (drop (struct.new_desc $object (i32.const 0) (ref.null (exact $descriptor))))))
(assert_return (invoke "run") (i32.const 77))
(assert_trap (invoke "null-descriptor") "null reference")
