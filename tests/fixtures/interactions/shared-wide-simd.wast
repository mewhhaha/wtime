;; Memory 1 has 64 one-byte pages. SIMD lanes at 0 are 1,2,3,4;
;; atomic word at 16 becomes 5+7=12, hence lane 2 + word = 15.
(module
  (type $pair (func (result i32 i32)))
  (table $dispatch i64 1 funcref)
  (func $pair (type $pair) i32.const 8 i32.const 13)
  (func $tail (type $pair) return_call $pair)
  (elem (table $dispatch) (i64.const 0) func $tail)
  (memory 1)
  (memory $wide (export "shared") i64 64 128 shared (pagesize 1))
  (func (export "run") (result i32)
    (v128.store $wide (i64.const 0) (v128.const i32x4 1 2 3 4))
    (i32.atomic.store $wide (i64.const 16) (i32.const 5))
    (drop (i32.atomic.rmw.add $wide (i64.const 16) (i32.const 7)))
    (memory.copy $wide $wide (i64.const 32) (i64.const 0) (i64.const 16))
    (i32.add (i32x4.extract_lane 2 (v128.load $wide (i64.const 32)))
      (i32.atomic.load $wide (i64.const 16))))
  (func (export "dispatch") (result i32)
    (call_indirect $dispatch (type $pair) (i64.const 0)) i32.add)
  (func (export "table-bounds") (result i32 i32)
    (call_indirect $dispatch (type $pair) (i64.const 1)))
  (func (export "read") (result i32) (i32.atomic.load $wide (i64.const 16)))
  (func (export "unaligned") (result i32) (i32.atomic.load $wide (i64.const 17)))
  (func (export "bounds") (result v128) (v128.load $wide (i64.const 60))))
(assert_return (invoke "run") (i32.const 15))
(assert_return (invoke "read") (i32.const 12))
(assert_trap (invoke "unaligned") "unaligned atomic")
(assert_trap (invoke "bounds") "out of bounds memory access")
(assert_return (invoke "dispatch") (i32.const 21))
(assert_trap (invoke "table-bounds") "undefined element")
