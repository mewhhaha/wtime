(module
  (tag $number (param i32))
  (func (export "run") (param $value i32) (result i32)
    (block $caught (result i32)
      (try_table (result i32) (catch $number $caught)
        (block $refcaught (result exnref)
          (try_table (catch_all_ref $refcaught)
            (local.get $value)
            (throw $number))
          (ref.null exn))
        (throw_ref)))))
