(module
  (type $worker_type (func (param i32) (result i32)))
  (type $worker_cont (cont $worker_type))
  (func $worker (type $worker_type) (local.get 0))
  (elem declare func $worker)
  (global $saved (mut (ref null $worker_cont)) (ref.null $worker_cont))
  (global $first_result (mut i32) (i32.const -1))
  (func (export "capture") (result i32)
    (global.set $saved (cont.new $worker_cont (ref.func $worker)))
    (i32.const 0))
  (func (export "resume_once") (result i32)
    (global.set $first_result (resume $worker_cont (i32.const 1) (global.get $saved)))
    (global.get $first_result))
  (func (export "first_result") (result i32)
    (global.get $first_result))
  (func (export "resume_reuse") (result i32)
    (resume $worker_cont (i32.const 2) (global.get $saved)))
  (func (export "clear") (result i32)
    (global.set $saved (ref.null $worker_cont))
    (i32.const 0)))
