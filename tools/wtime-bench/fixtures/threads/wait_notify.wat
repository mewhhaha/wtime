(module
  (import "env" "memory" (memory 1 1 shared))
  (func (export "wait") (param $expected i32) (param $timeout i64) (result i32)
    (memory.atomic.wait32 (i32.const 0) (local.get $expected) (local.get $timeout)))
  (func (export "notify") (param $count i32) (result i32)
    (memory.atomic.notify (i32.const 0) (local.get $count)))
  (func (export "store") (param $value i32)
    (i32.atomic.store (i32.const 0) (local.get $value)))
  (func (export "load") (result i32)
    (i32.atomic.load (i32.const 0))))
