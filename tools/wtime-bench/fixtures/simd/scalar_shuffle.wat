(module
  (func (export "run") (param $n i32) (result i32)
    (local $i i32)
    (local $a0 i32) (local $a1 i32) (local $a2 i32) (local $a3 i32)
    (local $a4 i32) (local $a5 i32) (local $a6 i32) (local $a7 i32)
    (local $a8 i32) (local $a9 i32) (local $a10 i32) (local $a11 i32)
    (local $a12 i32) (local $a13 i32) (local $a14 i32) (local $a15 i32)
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $a0 (i32.xor (local.get $a0) (i32.const 31)))
        (local.set $a1 (i32.xor (local.get $a1) (i32.const 30)))
        (local.set $a2 (i32.xor (local.get $a2) (i32.const 29)))
        (local.set $a3 (i32.xor (local.get $a3) (i32.const 28)))
        (local.set $a4 (i32.xor (local.get $a4) (i32.const 27)))
        (local.set $a5 (i32.xor (local.get $a5) (i32.const 26)))
        (local.set $a6 (i32.xor (local.get $a6) (i32.const 25)))
        (local.set $a7 (i32.xor (local.get $a7) (i32.const 24)))
        (local.set $a8 (i32.xor (local.get $a8) (i32.const 23)))
        (local.set $a9 (i32.xor (local.get $a9) (i32.const 22)))
        (local.set $a10 (i32.xor (local.get $a10) (i32.const 21)))
        (local.set $a11 (i32.xor (local.get $a11) (i32.const 20)))
        (local.set $a12 (i32.xor (local.get $a12) (i32.const 19)))
        (local.set $a13 (i32.xor (local.get $a13) (i32.const 18)))
        (local.set $a14 (i32.xor (local.get $a14) (i32.const 17)))
        (local.set $a15 (i32.xor (local.get $a15) (i32.const 16)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (i32.add
      (i32.add (i32.add (i32.add (local.get $a0) (local.get $a1)) (i32.add (local.get $a2) (local.get $a3)))
               (i32.add (i32.add (local.get $a4) (local.get $a5)) (i32.add (local.get $a6) (local.get $a7))))
      (i32.add (i32.add (i32.add (local.get $a8) (local.get $a9)) (i32.add (local.get $a10) (local.get $a11)))
               (i32.add (i32.add (local.get $a12) (local.get $a13)) (i32.add (local.get $a14) (local.get $a15)))))))
