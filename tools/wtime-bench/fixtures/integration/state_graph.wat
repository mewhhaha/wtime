(module
  (rec (type $node (struct (field i32) (field (ref null $node)))))
  (type $unary (func (result i32)))
  (memory (export "memory") 1 1)
  (global (export "state") (mut i32) (i32.const 0))
  (global $root (export "root") (mut (ref null $node)) (ref.null $node))
  (table (export "table") 2 funcref)
  (func $helper (type $unary) (i32.const 42))
  (elem (i32.const 0) $helper)
  (func (export "run") (result i32)
    (global.set $root
      (struct.new $node (i32.const 12)
        (struct.new $node (i32.const 19) (ref.null $node))))
    (global.set 0 (i32.const 33))
    (i32.store (i32.const 0) (i32.const 33))
    (i32.const 0)
    (call_indirect (type $unary)))
  (func (export "graph") (result i32 i32 i32 i32)
    (local $cursor (ref null $node))
    (local $count i32)
    (local $head i32)
    (local $next i32)
    (local.set $cursor (global.get $root))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $count) (i32.const 2)))
        (br_if $done (ref.is_null (local.get $cursor)))
        (if (i32.eqz (local.get $count))
          (then (local.set $head (struct.get $node 0 (local.get $cursor))))
          (else (local.set $next (struct.get $node 0 (local.get $cursor)))))
        (local.set $cursor (struct.get $node 1 (local.get $cursor)))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (br $walk)))
    (local.get $count)
    (local.get $head)
    (local.get $next)
    (ref.is_null (local.get $cursor))))
