(module
  (type $unary (func (param i32) (result i32)))
  (type $other (func (param i64) (result i64)))
  (table 1 funcref)
  (func $step_a (type $unary) (param $x i32) (result i32)
    (i32.add (local.get $x) (i32.const 1)))
  (func $step_b (type $unary) (param $x i32) (result i32)
    (i32.add (i32.mul (local.get $x) (i32.const 2)) (i32.const 1)))
  (func $wrong (type $other) (param $x i64) (result i64)
    (i64.add (local.get $x) (i64.const 1)))
  (elem declare func $step_a $step_b $wrong)
  (elem (i32.const 0) $step_a)
  (func (export "set_target") (param $target i32)
    (if (i32.eqz (local.get $target))
      (then (table.set (i32.const 0) (ref.func $step_a)))
      (else (table.set (i32.const 0) (ref.func $step_b)))))
  (func (export "run") (param $n i32) (result i32)
    (local $i i32) (local $acc i32)
    (local.set $acc (i32.const 1))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $acc (call_indirect (type $unary) (local.get $acc) (i32.const 0)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (local.get $acc))
  (func (export "probe_null") (result i32)
    (table.set (i32.const 0) (ref.null func))
    (call_indirect (type $unary) (i32.const 1) (i32.const 0)))
  (func (export "probe_mismatch") (result i32)
    (table.set (i32.const 0) (ref.func $wrong))
    (call_indirect (type $unary) (i32.const 1) (i32.const 0))))
