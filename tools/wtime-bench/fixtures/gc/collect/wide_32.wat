(module
  (type $leaf (struct (field i32)))
  (type $roots_type (array (mut (ref null $leaf))))
  (import "env" "collect" (func $collect (result i32)))
  (global $roots (mut (ref null $roots_type)) (ref.null $roots_type))
  (func (export "init")
    (global.set $roots (array.new_fixed $roots_type 32
    (struct.new $leaf (i32.const 0))
    (struct.new $leaf (i32.const 1))
    (struct.new $leaf (i32.const 2))
    (struct.new $leaf (i32.const 3))
    (struct.new $leaf (i32.const 4))
    (struct.new $leaf (i32.const 5))
    (struct.new $leaf (i32.const 6))
    (struct.new $leaf (i32.const 7))
    (struct.new $leaf (i32.const 8))
    (struct.new $leaf (i32.const 9))
    (struct.new $leaf (i32.const 10))
    (struct.new $leaf (i32.const 11))
    (struct.new $leaf (i32.const 12))
    (struct.new $leaf (i32.const 13))
    (struct.new $leaf (i32.const 14))
    (struct.new $leaf (i32.const 15))
    (struct.new $leaf (i32.const 16))
    (struct.new $leaf (i32.const 17))
    (struct.new $leaf (i32.const 18))
    (struct.new $leaf (i32.const 19))
    (struct.new $leaf (i32.const 20))
    (struct.new $leaf (i32.const 21))
    (struct.new $leaf (i32.const 22))
    (struct.new $leaf (i32.const 23))
    (struct.new $leaf (i32.const 24))
    (struct.new $leaf (i32.const 25))
    (struct.new $leaf (i32.const 26))
    (struct.new $leaf (i32.const 27))
    (struct.new $leaf (i32.const 28))
    (struct.new $leaf (i32.const 29))
    (struct.new $leaf (i32.const 30))
    (struct.new $leaf (i32.const 31)))))
  (func (export "run") (param $repetitions i32) (result i32)
    (local $sum i32) (local $iteration i32) (local $index i32)
    (block $calls_done
      (loop $calls
        (br_if $calls_done (i32.ge_u (local.get $iteration) (local.get $repetitions)))
        (local.set $sum (i32.add (local.get $sum) (call $collect)))
        (local.set $iteration (i32.add (local.get $iteration) (i32.const 1)))
        (br $calls)))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.ge_u (local.get $index) (i32.const 32)))
        (local.set $sum
          (i32.add (local.get $sum)
            (struct.get $leaf 0
              (array.get $roots_type (global.get $roots) (local.get $index)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (local.get $sum))
  (func (export "clear")
    (global.set $roots (ref.null $roots_type)))
)
