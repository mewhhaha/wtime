    (struct.new $leaf (i32.const 992))
    (struct.new $leaf (i32.const 993))
    (struct.new $leaf (i32.const 994))
    (struct.new $leaf (i32.const 995))
    (struct.new $leaf (i32.const 996))
    (struct.new $leaf (i32.const 997))
    (struct.new $leaf (i32.const 998))
    (struct.new $leaf (i32.const 999))
    (struct.new $leaf (i32.const 1000))
    (struct.new $leaf (i32.const 1001))
    (struct.new $leaf (i32.const 1002))
    (struct.new $leaf (i32.const 1003))
    (struct.new $leaf (i32.const 1004))
    (struct.new $leaf (i32.const 1005))
    (struct.new $leaf (i32.const 1006))
    (struct.new $leaf (i32.const 1007))
    (struct.new $leaf (i32.const 1008))
    (struct.new $leaf (i32.const 1009))
    (struct.new $leaf (i32.const 1010))
    (struct.new $leaf (i32.const 1011))
    (struct.new $leaf (i32.const 1012))
    (struct.new $leaf (i32.const 1013))
    (struct.new $leaf (i32.const 1014))
    (struct.new $leaf (i32.const 1015))
    (struct.new $leaf (i32.const 1016))
    (struct.new $leaf (i32.const 1017))
    (struct.new $leaf (i32.const 1018))
    (struct.new $leaf (i32.const 1019))
    (struct.new $leaf (i32.const 1020))
    (struct.new $leaf (i32.const 1021))
    (struct.new $leaf (i32.const 1022))
    (struct.new $leaf (i32.const 1023)))))
  (func (export "run") (param $repetitions i32) (result i32)
    (local $sum i32) (local $iteration i32) (local $index i32)
    (block $calls_done
      (loop $calls
        (br_if $calls_done (i32.ge_u (local.get $iteration) (local.get $repetitions)))
        (local.set $sum (i32.add (local.get $sum) (call $collect)))
        (local.set $iteration (i32.add (local.get $iteration) (i32.const 1)))
        (br $calls)))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.ge_u (local.get $index) (i32.const 1024)))
        (local.set $sum
          (i32.add (local.get $sum)
            (struct.get $leaf 0
              (array.get $roots_type (global.get $roots) (local.get $index)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (local.get $sum))
  (func (export "clear")
    (global.set $roots (ref.null $roots_type)))
)
