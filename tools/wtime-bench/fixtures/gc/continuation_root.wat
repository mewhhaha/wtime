(module
  (import "env" "collect" (func $collect))
  (rec
    (type $object (descriptor $descriptor) (struct (field i32)))
    (type $descriptor (describes $object) (struct (field i32))))
  (type $worker_type (func (result i32)))
  (type $worker_cont (cont $worker_type))
  (type $resume_type (func (param i32) (result i32)))
  (type $resume_cont (cont $resume_type))
  (tag $yield (result i32))
  (tag $object_error (param (ref $object)))
  (func $worker (type $worker_type) (local $object_value (ref null $object))
    (local.set $object_value
      (struct.new_desc $object (i32.const 77)
        (struct.new $descriptor (i32.const 9))))
    (block $caught (result (ref $object))
      (try_table (result (ref $object)) (catch $object_error $caught)
        (drop (suspend $yield))
        (throw $object_error (ref.as_non_null (local.get $object_value)))))
    (struct.get $object 0))
  (elem declare func $worker)
  (func (export "run") (param $value i32) (result i32)
    (local $continuation (ref null $resume_cont))
    (block $paused (result (ref $resume_cont))
      (resume $worker_cont (on $yield $paused)
        (cont.new $worker_cont (ref.func $worker)))
      (return))
    (local.set $continuation)
    (call $collect)
    (drop (resume $resume_cont (i32.const 42) (local.get $continuation)))
    (local.get $value)))
