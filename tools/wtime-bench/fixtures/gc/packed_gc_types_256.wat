  ;; Local type index 256: packed mutable byte array.
  (type $packed_array_256 (array (mut i8)))
  ;; Local type index 257: packed mutable byte struct field.
  (type $packed_struct_256 (struct (field (mut i8))))
  (func (export "run") (param $n i32) (result i32)
    (local $items (ref null $packed_array_256))
    (local $i i32)
    (local $sum i32)
    (local.set $items (array.new $packed_array_256 (i32.const -1) (i32.const 1)))
    (block $done
