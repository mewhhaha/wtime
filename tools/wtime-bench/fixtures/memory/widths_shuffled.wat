(module
  (memory (export "memory") 1 1)
  (func (export "run") (param $count i32) (result i32)
    (local $i i32) (local $base i32) (local $sum i32)
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $base
          (i32.add (i32.mul (i32.and (i32.mul (local.get $i) (i32.const 251)) (i32.const 255)) (i32.const 32)) (i32.const 1)))
        (i32.store8 (local.get $base) (i32.const -2))
        (local.set $sum (i32.add (local.get $sum) (i32.load8_s (local.get $base))))
        (local.set $sum (i32.add (local.get $sum) (i32.load8_u (local.get $base))))
        (i32.store16 (i32.add (local.get $base) (i32.const 2)) (i32.const 32769))
        (local.set $sum (i32.add (local.get $sum) (i32.load16_s (i32.add (local.get $base) (i32.const 2)))))
        (local.set $sum (i32.add (local.get $sum) (i32.load16_u (i32.add (local.get $base) (i32.const 2)))))
        (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.const -2147483647))
        (local.set $sum (i32.add (local.get $sum) (i32.load (i32.add (local.get $base) (i32.const 4)))))
        (i64.store8 (i32.add (local.get $base) (i32.const 8)) (i64.const -2))
        (local.set $sum (i32.add (local.get $sum) (i32.wrap_i64 (i64.load8_s (i32.add (local.get $base) (i32.const 8))))))
        (local.set $sum (i32.add (local.get $sum) (i32.wrap_i64 (i64.load8_u (i32.add (local.get $base) (i32.const 8))))))
        (i64.store16 (i32.add (local.get $base) (i32.const 10)) (i64.const 32769))
        (local.set $sum (i32.add (local.get $sum) (i32.wrap_i64 (i64.load16_s (i32.add (local.get $base) (i32.const 10))))))
        (local.set $sum (i32.add (local.get $sum) (i32.wrap_i64 (i64.load16_u (i32.add (local.get $base) (i32.const 10))))))
        (i64.store32 (i32.add (local.get $base) (i32.const 12)) (i64.const -2147483647))
        (local.set $sum (i32.add (local.get $sum) (i32.wrap_i64 (i64.load32_s (i32.add (local.get $base) (i32.const 12))))))
        (local.set $sum (i32.add (local.get $sum) (i32.wrap_i64 (i64.load32_u (i32.add (local.get $base) (i32.const 12))))))
        (i64.store (i32.add (local.get $base) (i32.const 16)) (i64.const -9223372036854775807))
        (local.set $sum (i32.add (local.get $sum) (i32.wrap_i64 (i64.load (i32.add (local.get $base) (i32.const 16))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
    (local.get $sum)))
